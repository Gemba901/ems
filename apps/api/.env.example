# Local development defaults. docker compose loads this file, then apps/api/.env
# on top of it, so copy this to .env only if you need to change something.
# These secrets are for local use only; never reuse them in staging or production.

PORT=5000
# local db (Docker container gemba_postgres_local) — used for local testing of the password reset flow
#DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/sth_local?schema=public"
# staging db
# DATABASE_URL="postgresql://postgres: "
DATABASE_URL=postgresql://gemba:gemba@localhost:5433/gemba_dev
JWT_SECRET=bff9dba2323cdbc283400dea8ebf6d0418eb48fab80246c41fa07c7a3a23c6a4cfe4b0901d66ffa809de1d2d6cd233b5
# Must match TENANT_PROXY_SECRET in apps/web/.env.example (64+ chars, no spaces).
#TENANT_BASE_DOMAIN=local
#TENANT_PROXY_SECRET=64-char-random-string-generate-with-openssl-rand-hex-32
TENANT_PROXY_SECRET=82b52df362592d49958acce57966c9f5c8e94c499cccf5352c3f45b1bf7cc258af64235c05ca5595496565747bfacd7e
TENANT_BASE_DOMAIN=localhost
WEB_APP_URL=http://localhost:3000

# Optional: uploads, email and the AI assistant stay off until these are set.
# AWS_REGION=
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=
# ANTHROPIC_API_KEY=

AWS_REGION=
AWS_S3_BUCKET=exmaple-valid
AWS_ACCESS_KEY_ID=examplevalidkey
AWS_SECRET_ACCESS_KEY=examplevalidkey
ANTHROPIC_API_KEY= examplevalidkey

SES_FROM_EMAIL=example@sth.com

ONBOARDING_ENABLED=true
ONBOARDING_WORKER_ENABLED=true
ONBOARDING_TOKEN_SECRET=64-char-random-string-generate-with-openssl-rand-hex-32
ONBOARDING_ORIGIN=http://localhost:3000
ONBOARDING_DEFAULT_MODULES=EMS
ONBOARDING_VERCEL_DOMAINS_ENABLED=false