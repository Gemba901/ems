generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum QuoteCategory {
  MOTIVATION
  PRODUCTIVITY
  WELLNESS
  CODING
  LEADERSHIP
  STUDY
}

enum ModuleType {
  SIMS
  EMS
  CALENDAR
  LEAVE
  STEEL
}

enum CommitteeType {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
  GENERAL
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGEMENT
  HR
  HOD
  EMPLOYEE
}

enum NotificationType {
  ACTION_REQUIRED // user must do something
  INFO            // information update
  REMINDER        // time based nudge
  ALERT           // urgent/system-lever
}

// EMS: Employee Master Data
enum EmploymentStatus {
  ACTIVE
  PROBATION
  RESIGNED
  TERMINATED
  RETIRED
  SUSPENDED
  ABSCONDED
  CONTRACT_ENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SkillLevel {
  LEVEL_1 // Learner
  LEVEL_2 // Can Work with Support
  LEVEL_3 // Can Work Independently
  LEVEL_4 // Can Train Others
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CASUAL
}

//organization
model Organization {
  id          String    @id @default(uuid())
  name        String
  shortName   String?
  logoUrl     String?
  industry    String?
  email       String?
  phone       String?
  address     String?
  status      OrgStatus  @default(ACTIVE)
  modules     ModuleType[] @default([])
  primaryColor String?    @default("#4F46E5")
  isAdminOrg  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userOrganizations UserOrganization[]
  employees   Employee[]
  departments Department[]
  suggestions Suggestion[]
  committees  SteeringCommittee[]
  consultancyVisits ConsultancyVisit[]
  visitRequests     VisitRequest[]
  visitMonthPlans   VisitMonthPlan[]
  leaveRequests     LeaveRequest[]
  leavePolicies     LeavePolicy[]
  leaveSettings     LeaveSettings?
  calendarEvents    CalendarEvent[]
  notices           Notice[]
  steelProductionPlans SteelProductionPlan[]
}

//specific user
model User {
  id                String @id @default(uuid())
  email             String? @unique
  phone             String  @unique
  password          String?
  name              String

  organizations     UserOrganization[]
  employees         Employee[]
  createdVisits     ConsultancyVisit[]
  visitRequests     VisitRequest[]
  visitMonthPlans   VisitMonthPlan[]
  calendarBlocks    CalendarBlock[]
  refreshTokens     RefreshToken[]
  reviewedLeaves    LeaveRequest[]    @relation("LeaveReviewer")

  createdAt         DateTime @default(now())
}

model RefreshToken {
  id             String   @id @default(uuid())
  tokenHash      String   @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserOrganization {
  userId         String
  organizationId String
  roleId         Int

  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@id([userId, organizationId])
}

model Role {
  id                Int @id
  name              RoleName @unique

  userOrganizations UserOrganization[]
  permissions       RolePermission[]
}

model Permission {
  id                String @id @default(uuid())
  name              String @unique
  description       String?

  roles             RolePermission[]
}


model RolePermission {
  roleId       Int
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Employee {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  departmentId   String?
  organizationId String
  userId         String?
  avatarUrl      String?

  // EMS: Identity group
  employeeCode   String?
  middleName     String?
  gender         Gender?
  dateOfBirth    DateTime?
  nationalId     String?
  nationality    String?

  // EMS: Work Allocation group
  employmentStatus EmploymentStatus @default(ACTIVE)
  employmentType   EmploymentType?
  jobTitle         String?
  dateJoined       DateTime?
  workStation      String?
  section          String?
  subSection       String?
  shift            String?
  reportingManagerId String?
  reportingManager   Employee?  @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      Employee[] @relation("ReportingManager")

  // EMS: Role & Responsibility group
  jobDescription     String?
  level              String?
  grade              String?
  jobCategory        String?
  primaryWorkRole    String?
  machineProcess     String?
  canBeAssignedTasks Boolean @default(true)
  canBeMember        Boolean @default(true)
  canBeLeader        Boolean @default(false)

  // EMS: Contact group (phone + email above; extras below)
  whatsappNumber               String?
  homeAddress                  String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // EMS: Skill group
  skillLevel     SkillLevel?
  trainingNeeded Boolean?

  // Notification preferences: { email: true, sms: false, whatsapp: false }
  notificationPreferences Json?

  // EMS: Record control
  hrRecordOwnerId    String?
  hrRecordOwner      Employee?  @relation("HRRecordOwner", fields: [hrRecordOwnerId], references: [id], onDelete: SetNull)
  hrManagedEmployees Employee[] @relation("HRRecordOwner")

  department        Department?  @relation(fields: [departmentId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])
  user              User?        @relation(fields: [userId], references: [id])
  suggestions       Suggestion[] @relation("EmployeeSuggestions")
  hodSuggestions    Suggestion[] @relation("HODSuggestions")
  suggestionReviews SuggestionReview[]
  committeeMembers      SteeringCommitteeMember[]
  notifications         Notification[]
  visitAttendances      VisitAttendee[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  handoverForLeaves     LeaveRequest[]     @relation("LeaveHandover")
  handoverForLeaves2    LeaveRequest[]     @relation("LeaveHandover2")
  createdCalendarEvents CalendarEvent[]    @relation("CalendarEventCreator")
  receivedInvitations   EventInvitation[]  @relation("ReceivedInvitations")
  eventParticipations   EventParticipant[] @relation("EventParticipations")

  steelPlansCreated     SteelProductionPlan[]  @relation("SteelPlanCreatedBy")
  steelPlansApproved    SteelProductionPlan[]  @relation("SteelPlanApprovedBy")
  steelActivityLogs     SteelPlanActivityLog[]
  steelDepartmentAcks   SteelPlanDepartmentAck[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([email, organizationId])
  @@unique([phone, organizationId])
}


model Department {
  id                String   @id @default(uuid())
  name              String
  organizationId    String
  minLeaveHeadcount Int      @default(1)

  employees      Employee[]
  organization   Organization @relation(fields: [organizationId], references: [id])
  suggestions    Suggestion[]
}

model SteeringCommittee {
  id             String        @id @default(uuid())
  name           String
  type           CommitteeType
  organizationId String
  createdAt      DateTime      @default(now())

  organization   Organization              @relation(fields: [organizationId], references: [id])
  members        SteeringCommitteeMember[]
}

model SteeringCommitteeMember {
  committeeId     String
  employeeId      String
  roleInCommittee String?

  committee    SteeringCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([committeeId, employeeId])
}

model Quotes {
  id          String  @id @default(uuid())
  text        String

  category    QuoteCategory?
  mood        String?

  timeOfDay   TimeOfDay[]
  tags        String[]

  author      String
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("quotes")
}

model Notification {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        NotificationType
  module      String    // "SIMS", "LEAVE", "ATTENDANCE", "HR"
  title       String
  message     String
  isRead      Boolean   @default(false)
  actionUrl   String?
  metadata    Json?     // any extra structured data the module wants to attach
  createdAt  DateTime   @default(now())

  @@index([employeeId, isRead])
  @@index([employeeId, createdAt])
  @@index([employeeId, module])
}

// SIMS: Suggestions and Idea Management System

enum SuggestionStatus {
  UNDER_REVIEW
  APPROVED_FOR_IMPLEMENTATION
  REJECTED
  ON_HOLD
  SELECTED_FOR_SGA
}

enum ImplementationStatus {
  WORK_IN_PROGRESS
  VERY_SLOW_WORK_IN_PROGRESS
  GOOD_WORK_IN_PROGRESS
  SLOW_PROGRESS
  IMPLEMENTED
  SHIFTED_TO_SGA
  PREVIOUSLY_IMPLEMENTED
  UNDER_CONSULTATION
  IMPRACTICAL
  SAVED_FOR_LATER
}

enum SuggestionCategory {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
  UNKNOWN
}

model Suggestion {
  id                   String                @id @default(uuid())
  title                String
  description          String
  imageUrl             String?
  status               SuggestionStatus      @default(UNDER_REVIEW)
  implementationStatus ImplementationStatus?
  implementationNote   String?
  categories           SuggestionCategory[]  @default([])
  isAnonymous          Boolean               @default(false)
  employeeId           String
  organizationId       String
  departmentId         String?
  hodId                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  employee     Employee           @relation("EmployeeSuggestions", fields: [employeeId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  department   Department?        @relation(fields: [departmentId], references: [id])
  hod          Employee?          @relation("HODSuggestions", fields: [hodId], references: [id], onDelete: SetNull)
  reviews      SuggestionReview[]
}

// Audit trail: every status change by a reviewer is recorded here
model SuggestionReview {
  id                  String           @id @default(uuid())
  suggestionId        String
  reviewerId          String
  statusChanged       SuggestionStatus
  note                String?
  createdAt           DateTime         @default(now())

  suggestion          Suggestion         @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  reviewer            Employee           @relation(fields: [reviewerId], references: [id])
}

// ── Calendar: Consultancy Visit Scheduling ────────────────────────────────────

enum RecurrencePattern {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// ── Holistic Calendar ─────────────────────────────────────────────────────────

// Google Calendar-style color swatches, freely chosen, no restriction on meaning
enum EventColor {
  TOMATO
  FLAMINGO
  TANGERINE
  BANANA
  SAGE
  BASIL
  PEACOCK
  BLUEBERRY
  LAVENDER
  GRAPE
  GRAPHITE
}

enum EventVisibility {
  PRIVATE   // visible only to creator + invited guests
  ORG_WIDE  // visible to every employee in the organization
}

enum EventRecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum VisitStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VisitRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CalendarEvent {
  id             String               @id @default(uuid())
  title          String
  description    String?
  label          String?
  color          EventColor           @default(PEACOCK)
  visibility     EventVisibility      @default(PRIVATE)
  startAt        DateTime
  endAt          DateTime
  allDay         Boolean              @default(false)
  organizationId String
  createdById    String

  // Recurrence
  isRecurring         Boolean                @default(false)
  recurrencePattern   EventRecurrencePattern?
  recurrenceInterval  Int                    @default(1)
  recurrenceEndAt     DateTime?
  parentEventId       String?

  organization   Organization         @relation(fields: [organizationId], references: [id])
  createdBy      Employee             @relation("CalendarEventCreator", fields: [createdById], references: [id])
  invitations    EventInvitation[]
  participants   EventParticipant[]
  parentEvent    CalendarEvent?       @relation("EventSeries", fields: [parentEventId], references: [id])
  childEvents    CalendarEvent[]      @relation("EventSeries")

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId, startAt])
  @@index([createdById, startAt])
}

// Tracks meeting invites + accept/decline responses (also serves as the accept/reject log)
model EventInvitation {
  id          String           @id @default(uuid())
  eventId     String
  inviteeId   String
  status      InvitationStatus @default(PENDING)
  respondedAt DateTime?

  event       CalendarEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitee     Employee         @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now())

  @@unique([eventId, inviteeId])
  @@index([inviteeId, status])
}

// Assigned participants for training sessions and audits (no accept/decline flow)
model EventParticipant {
  id         String        @id @default(uuid())
  eventId    String
  employeeId String

  event      CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employee   Employee      @relation("EventParticipations", fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt  DateTime      @default(now())

  @@unique([eventId, employeeId])
}

model ConsultancyVisit {
  id                 String              @id @default(uuid())
  title              String
  clientOrgId        String
  date               DateTime
  endDate            DateTime?
  startTime          String?
  endTime            String?
  status             VisitStatus         @default(TENTATIVE)
  notes              String?
  internalNotes      String?
  completionNote     String?
  recurrencePattern  RecurrencePattern?
  recurrenceEndDate  DateTime?
  recurrenceGroupId  String?
  rescheduleCount    Int                 @default(0)
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  clientOrg          Organization        @relation(fields: [clientOrgId], references: [id])
  createdBy          User                @relation(fields: [createdById], references: [id])
  attendees          VisitAttendee[]
  sourceRequest      VisitRequest?

  @@index([recurrenceGroupId])
}

model VisitMonthPlan {
  id          String         @id @default(uuid())
  clientOrgId String
  year        Int
  month       Int
  plannedDays Int            @default(1)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  clientOrg   Organization   @relation(fields: [clientOrgId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])
  slots       VisitPlanSlot[]

  @@unique([clientOrgId, year, month])
}

model VisitPlanSlot {
  id         String         @id @default(uuid())
  planId     String
  slotIndex  Int
  date       DateTime?
  agenda     String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  plan       VisitMonthPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, slotIndex])
}

model VisitRequest {
  id              String             @id @default(uuid())
  organizationId  String
  requestedDate   DateTime
  preferredTime   String?
  message         String?
  status          VisitRequestStatus @default(PENDING)
  responseNote    String?
  visitId         String?            @unique
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id])
  createdBy       User              @relation(fields: [createdById], references: [id])
  visit           ConsultancyVisit? @relation(fields: [visitId], references: [id])
}

model VisitAttendee {
  id         String           @id @default(uuid())
  visitId    String
  employeeId String
  role       String?

  visit      ConsultancyVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([visitId, employeeId])
}

enum CalendarBlockType {
  HOLIDAY
  BUSY_DAY
}

model CalendarBlock {
  id          String            @id @default(uuid())
  date        DateTime
  type        CalendarBlockType
  label       String?
  createdById String
  createdAt   DateTime          @default(now())

  createdBy   User              @relation(fields: [createdById], references: [id])
}

// ── Leave Management ──────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String      @id @default(uuid())
  employeeId     String
  organizationId String
  type           String
  status         LeaveStatus @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  days           Int
  reason              String?
  handoverEmployeeId  String?
  handoverNotes       String?
  handoverEmployee2Id String?
  handoverNotes2      String?
  reviewedById        String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id])
  handoverEmployee  Employee?    @relation("LeaveHandover",  fields: [handoverEmployeeId],  references: [id], onDelete: SetNull)
  handoverEmployee2 Employee?    @relation("LeaveHandover2", fields: [handoverEmployee2Id], references: [id], onDelete: SetNull)
  reviewedBy        User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([organizationId, status])
  @@index([organizationId, startDate])
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  year        Int
  type        String
  allocated   Int       @default(0)
  used        Int       @default(0)

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, type])
  @@index([employeeId, year])
}

model LeavePolicy {
  id             String       @id @default(uuid())
  organizationId String
  year           Int
  type           String
  allocated      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year, type])
  @@index([organizationId, year])
}

model LeaveSettings {
  id                String   @id @default(uuid())
  organizationId    String   @unique
  workingDays       Int[]    @default([1,2,3,4,5])
  enabledTypes      String[] @default([])
  customLeaveTypes  Json     @default("[]")
  updatedAt         DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Notice {
  id             String    @id @default(cuid())
  organizationId String
  type           String    @default("INFO")
  title          String
  body           String
  pinned         Boolean   @default(false)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}
   
// ── Steel ──────────────────────────────────────────────────────────
// ── Steel Manufacturing: Process 1 — Planning (P01-A01..A12) ─────────────────

enum DemandSource {
  CUSTOMER_ORDER
  DEALER_REQUIREMENT
  PROJECT_REQUIREMENT
  FORECAST
  INTERNAL_STOCK_PLAN
}

enum OrderPriority {
  NORMAL
  URGENT
  EXPORT
  PROJECT
  STOCK_REPLENISHMENT
}

enum CreditStatus {
  APPROVED
  ON_HOLD
  PENDING
}

enum ProductType {
  TMT_BAR
  BILLET
  WIRE_ROD
  SECTION
  OTHER
}

enum StockDecision {
  DISPATCH_FROM_STOCK
  PRODUCTION_REQUIRED
}

enum PlantRoute {
  INTEGRATED_PLANT
  SCRAP_BASED_FURNACE_PLANT
  RE_ROLLER_PLANT
  OWN_CCM_BILLET_ROUTE
  LOCAL_PURCHASED_BILLET_ROUTE
  IMPORTED_BILLET_ROUTE
  HOT_CHARGE_ROUTE
  COLD_CHARGE_ROUTE
  MULTIPLE_ROUTES
}

enum AvailabilityStatus {
  AVAILABLE
  PARTIAL
  NOT_AVAILABLE
}

// Tracks how far the plan has progressed through P01-A01..A12
enum SteelPlanStage {
  A01_DEMAND_CAPTURED
  A02_PRIORITY_CONFIRMED
  A03_PRODUCT_CONFIRMED
  A04_SPEC_CONFIRMED
  A05_STOCK_CHECKED
  A06_STOCK_DECISION_MADE
  A07_ROUTE_SELECTED
  A08_MATERIAL_CHECKED
  A09_CAPACITY_CHECKED
  A10_PLAN_DRAFTED
  A11_PLAN_COMMUNICATED
  A12_PLAN_RELEASED
}

enum SteelPlanOverallStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  RELEASED
  CANCELLED
}

// Identifies each of the 12 planning activities for the audit trail
enum SteelPlanActivity {
  A01
  A02
  A03
  A04
  A05
  A06
  A07
  A08
  A09
  A10
  A11
  A12
}

// Departments that must acknowledge the released plan (P01-A11)
enum SteelDepartment {
  PROCUREMENT
  YARD
  FURNACE
  CCM
  ROLLING
  QUALITY
  MAINTENANCE
  STORES
  DISPATCH
}

// One record per customer demand / production plan, carried through P01-A01 -> P01-A12.
model SteelProductionPlan {
  id             String                  @id @default(uuid())
  planNumber     String                  @unique
  organizationId String
  createdById    String
  stage          SteelPlanStage          @default(A01_DEMAND_CAPTURED)
  status         SteelPlanOverallStatus  @default(DRAFT)

  // P01-A01 — Capture customer enquiry, sales order, forecast, or stock requirement
  demandSource               DemandSource
  customerName               String?
  dealerName                 String?
  projectReference           String?
  salesOrderNumber           String?
  forecastReference          String?
  stockRequirementReference  String?
  expectedDeliveryDate       DateTime?
  requestedQuantityTonnes    Float
  demandNotes                String?

  // P01-A02 — Confirm customer and order priority
  priority               OrderPriority?
  deliveryPromiseDate    DateTime?
  creditStatus           CreditStatus?

  // P01-A03 — Confirm product type and standard required
  productType            ProductType?
  productStandard        String?
  customerSpecification  String?

  // P01-A04 — Confirm grade, size, length, bundle, and quantity
  grade           String?
  size            String?
  length          String?
  bundleType      String?
  totalQuantity   Float?
  toleranceNotes  String?

  // P01-A05 — Check certified finished goods stock
  certifiedStockAvailableQty  Float?
  stockBundleIds              String[]  @default([])
  stockHeatNumbers            String[]  @default([])
  stockCertificateRefs        String[]  @default([])

  // P01-A06 — Decide dispatch from stock or production required
  stockDecision       StockDecision?
  stockDecisionNotes  String?

  // P01-A07 — Select applicable plant route
  plantRoute  PlantRoute?
  routeNotes  String?

  // P01-A08 — Check raw material or billet availability
  materialAvailability      AvailabilityStatus?
  materialShortageNotes     String?
  purchaseRequirementNotes  String?

  // P01-A09 — Check equipment, maintenance, and manpower availability
  equipmentAvailability      AvailabilityStatus?
  manpowerAvailability       AvailabilityStatus?
  maintenanceShutdownNotes   String?
  shiftPlanNotes             String?

  // P01-A10 — Prepare production plan and sequence
  productionSequence  Json?
  plannedStartDate    DateTime?
  plannedEndDate      DateTime?
  planNotes           String?

  // P01-A11 — Communicate plan to all concerned departments
  planCommunicatedAt  DateTime?

  // P01-A12 — Release approved production plan
  approvedById   String?
  approvedAt     DateTime?
  releaseNotes   String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  organization    Organization              @relation(fields: [organizationId], references: [id])
  createdBy       Employee                  @relation("SteelPlanCreatedBy", fields: [createdById], references: [id])
  approvedBy      Employee?                 @relation("SteelPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  activityLogs    SteelPlanActivityLog[]
  departmentAcks  SteelPlanDepartmentAck[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, status])
}

// Audit trail: every activity performed against a plan is recorded here
model SteelPlanActivityLog {
  id            String             @id @default(uuid())
  planId        String
  activity      SteelPlanActivity
  performedById String
  notes         String?
  data          Json?
  createdAt     DateTime           @default(now())

  plan        SteelProductionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  performedBy Employee             @relation(fields: [performedById], references: [id])

  @@index([planId])
}

// P01-A11: department acknowledgement of the communicated plan
model SteelPlanDepartmentAck {
  id               String           @id @default(uuid())
  planId           String
  department       SteelDepartment
  acknowledged     Boolean          @default(false)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  notes            String?
  createdAt        DateTime         @default(now())

  plan            SteelProductionPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  acknowledgedBy  Employee?            @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([planId, department])
  @@index([planId])
}
