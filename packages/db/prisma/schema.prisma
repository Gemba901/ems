generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum QuoteCategory {
  MOTIVATION
  PRODUCTIVITY
  WELLNESS
  CODING
  LEADERSHIP
  STUDY
}

enum ModuleType {
  SIMS
  EMS
  CALENDAR
  LEAVE
  DWMS
  KAIZEN
}

enum CommitteeType {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
  GENERAL
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGEMENT
  HR
  HOD
  EMPLOYEE
}

enum NotificationType {
  ACTION_REQUIRED // user must do something
  INFO // information update
  REMINDER // time based nudge
  ALERT // urgent/system-lever
}

// EMS: Employee Master Data
enum EmploymentStatus {
  ACTIVE
  PROBATION
  RESIGNED
  TERMINATED
  RETIRED
  SUSPENDED
  ABSCONDED
  CONTRACT_ENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SkillLevel {
  LEVEL_1 // Learner
  LEVEL_2 // Can Work with Support
  LEVEL_3 // Can Work Independently
  LEVEL_4 // Can Train Others
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CASUAL
}

enum TicketType {
  SYSTEM_TICKET
  COMPANY_TICKET
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

//organization
model Organization {
  id           String       @id @default(uuid())
  name         String
  shortName    String?
  logoUrl      String?
  industry     String?
  email        String?
  phone        String?
  address      String?
  status       OrgStatus    @default(ACTIVE)
  modules      ModuleType[] @default([])
  primaryColor String?      @default("#4F46E5")
  isAdminOrg   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  userOrganizations    UserOrganization[]
  employees            Employee[]
  departments          Department[]
  suggestions          Suggestion[]
  committees           SteeringCommittee[]
  consultancyVisits    ConsultancyVisit[]
  visitRequests        VisitRequest[]
  visitMonthPlans      VisitMonthPlan[]
  leaveRequests        LeaveRequest[]
  leavePolicies        LeavePolicy[]
  leaveSettings        LeaveSettings?
  dwmsPermissionConfig DwmsPermissionConfig?
  calendarEvents       CalendarEvent[]
  notices              Notice[]
  alerts               Alert[]
  tickets              Tickets[]
  kaizens              Kaizen[]

  // SIMS: single designated committee that SELECTED_FOR_SGA suggestions are forwarded to
  sgaCommitteeId String?
  sgaCommittee   SteeringCommittee? @relation("OrgSgaCommittee", fields: [sgaCommitteeId], references: [id], onDelete: SetNull)
}

//specific user
model User {
  id       String  @id @default(uuid())
  email    String? @unique
  phone    String  @unique
  password String?
  name     String

  organizations       UserOrganization[]
  employees           Employee[]
  createdVisits       ConsultancyVisit[]
  visitRequests       VisitRequest[]
  visitMonthPlans     VisitMonthPlan[]
  calendarBlocks      CalendarBlock[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  reviewedLeaves      LeaveRequest[]       @relation("LeaveReviewer")

  createdAt DateTime @default(now())
}

model RefreshToken {
  id             String   @id @default(uuid())
  tokenHash      String   @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserOrganization {
  userId         String
  organizationId String
  roleId         Int

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  @@id([userId, organizationId])
}

model Role {
  id   Int      @id
  name RoleName @unique

  userOrganizations UserOrganization[]
  permissions       RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Employee {
  id             String  @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  departmentId   String?
  organizationId String
  userId         String?
  avatarUrl      String?

  // EMS: Identity group
  employeeCode String?
  middleName   String?
  gender       Gender?
  dateOfBirth  DateTime?
  nationalId   String?
  nationality  String?
  plantBranch  String?

  // EMS: Work Allocation group
  employmentStatus   EmploymentStatus @default(ACTIVE)
  employmentType     EmploymentType?
  jobTitle           String?
  dateJoined         DateTime?
  workStation        String?
  section            String?
  subSection         String?
  shift              String?
  reportingManagerId String?
  reportingManager   Employee?        @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      Employee[]       @relation("ReportingManager")

  // EMS: Role & Responsibility group
  jobDescription     String?
  level              String?
  grade              String?
  jobCategory        String?
  primaryWorkRole    String?
  machineProcess     String?
  canBeAssignedTasks Boolean @default(true)
  canBeMember        Boolean @default(true)
  canBeLeader        Boolean @default(false)

  // EMS: Contact group (phone + email above; extras below)
  whatsappNumber               String?
  homeAddress                  String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // EMS: Skill group
  skillLevel     SkillLevel?
  trainingNeeded Boolean?

  // Notification preferences: { email: true, sms: false, whatsapp: false }
  notificationPreferences Json?

  // EMS: Record control
  hrRecordOwnerId    String?
  hrRecordOwner      Employee?  @relation("HRRecordOwner", fields: [hrRecordOwnerId], references: [id], onDelete: SetNull)
  hrManagedEmployees Employee[] @relation("HRRecordOwner")

  department            Department?               @relation(fields: [departmentId], references: [id])
  organization          Organization              @relation(fields: [organizationId], references: [id])
  user                  User?                     @relation(fields: [userId], references: [id])
  suggestions           Suggestion[]              @relation("EmployeeSuggestions")
  hodSuggestions        Suggestion[]              @relation("HODSuggestions")
  suggestionReviews     SuggestionReview[]
  committeeMembers      SteeringCommitteeMember[]
  notifications         Notification[]
  visitAttendances      VisitAttendee[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  handoverForLeaves     LeaveRequest[]            @relation("LeaveHandover")
  handoverForLeaves2    LeaveRequest[]            @relation("LeaveHandover2")
  createdCalendarEvents CalendarEvent[]           @relation("CalendarEventCreator")
  receivedInvitations   EventInvitation[]         @relation("ReceivedInvitations")
  eventParticipations   EventParticipant[]        @relation("EventParticipations")
  oooBlocks             CalendarBlock[]
  calendarFilters       CalendarFilter[]
  assignedTasks         Task[]                    @relation("TaskAssignedBy")
  tasks                 Task[]                    @relation("TaskOwner")
  tasksToApprove        Task[]                    @relation("TaskApprovedBy")
  backupTasks           Task[]                    @relation("TaskBackupOwner")
  taskInstances         TaskInstance[]
  alertsRaised          Alert[]                   @relation("AlertsRaised")
  alertsAgainst         Alert[]                   @relation("AlertsAgainst")
  ticketsRaised         Tickets[]                 @relation("ticketsRaisedBy")
  ticketUpdates         TicketUpdate[]
  kaizensRaised         Kaizen[]                  @relation("KaizenRaisedBy")
  kaizensOwned          Kaizen[]                  @relation("KaizenOwner")
  kaizenHodPreReviews   Kaizen[]                  @relation("KaizenHodPreReviewBy")
  kaizenTeamMemberships Kaizen[]                  @relation("KaizenTeamMembers")
  kaizenReviews         KaizenReview[]
  kaizenVerifications   KaizenVerification[]      @relation("KaizenVerificationBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId])
  @@unique([phone, organizationId])
  @@unique([employeeCode, organizationId])
}

model Department {
  id                String  @id @default(uuid())
  name              String
  organizationId    String
  minLeaveHeadcount Int     @default(1)
  isPlatformTeam    Boolean @default(false)

  employees    Employee[]
  organization Organization @relation(fields: [organizationId], references: [id])
  suggestions  Suggestion[]
  tasks        Task[]
  alerts       Alert[]
  kaizens      Kaizen[]
}

model SteeringCommittee {
  id             String        @id @default(uuid())
  name           String
  type           CommitteeType
  organizationId String
  createdAt      DateTime      @default(now())

  organization      Organization              @relation(fields: [organizationId], references: [id])
  members           SteeringCommitteeMember[]
  suggestions       Suggestion[]
  designatedForOrgs Organization[]            @relation("OrgSgaCommittee")
}

model SteeringCommitteeMember {
  committeeId     String
  employeeId      String
  roleInCommittee String?

  committee SteeringCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  employee  Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([committeeId, employeeId])
}

model Quotes {
  id   String @id @default(uuid())
  text String

  category QuoteCategory?
  mood     String?

  timeOfDay TimeOfDay[]
  tags      String[]

  author String
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("quotes")
}

model Notification {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       NotificationType
  module     String // "SIMS", "LEAVE", "ATTENDANCE", "HR"
  title      String
  message    String
  isRead     Boolean          @default(false)
  actionUrl  String?
  metadata   Json? // any extra structured data the module wants to attach
  createdAt  DateTime         @default(now())

  @@index([employeeId, isRead])
  @@index([employeeId, createdAt])
  @@index([employeeId, module])
}

// TICKETING SYSTEM

model Tickets {
  id             String         @id @default(uuid())
  organizationId String
  raisedById     String
  type           TicketType
  module         String // "SIMS", "LEAVE", "ATTENDANCE", "HR"
  subject        String
  message        String
  department     String?
  status         TicketStatus   @default(OPEN)
  updates        TicketUpdate[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  raisedBy     Employee     @relation("ticketsRaisedBy", fields: [raisedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([raisedById, createdAt])
}

model TicketUpdate {
  id            String        @id @default(uuid())
  ticketId      String
  updatedById   String
  statusChanged TicketStatus?
  typeChanged   TicketType?
  note          String?
  createdAt     DateTime      @default(now())

  ticket    Tickets  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  updatedBy Employee @relation(fields: [updatedById], references: [id])
}

// SIMS: Suggestions and Idea Management System

enum SuggestionStatus {
  WAITING_FOR_REVIEW
  UNDER_REVIEW
  APPROVED_FOR_IMPLEMENTATION
  REJECTED
  ON_HOLD
  SELECTED_FOR_SGA
  IMPLEMENTED
}

enum DecisionType {
  WORKPLACE_CORRECTION
  DAILY_KAIZEN
}

enum ImplementationStatus {
  WORK_IN_PROGRESS
  VERY_SLOW_WORK_IN_PROGRESS
  GOOD_WORK_IN_PROGRESS
  SLOW_PROGRESS
  IMPLEMENTED
  SHIFTED_TO_SGA
  PREVIOUSLY_IMPLEMENTED
  UNDER_CONSULTATION
  IMPRACTICAL
  SAVED_FOR_LATER
}

enum SuggestionCategory {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
  UNKNOWN
}

model Suggestion {
  id                     String                @id @default(uuid())
  title                  String
  description            String
  imageUrl               String?
  status                 SuggestionStatus      @default(WAITING_FOR_REVIEW)
  implementationStatus   ImplementationStatus?
  implementationNote     String?
  decisionType           DecisionType?
  decisionDetails        Json?
  categories             SuggestionCategory[]  @default([])
  isAnonymous            Boolean               @default(false)
  employeeId             String
  organizationId         String
  departmentId           String?
  hodId                  String?
  committeeId            String?
  forwardedToCommitteeAt DateTime?
  linkedKaizenId         String?               @unique
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  employee     Employee           @relation("EmployeeSuggestions", fields: [employeeId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  department   Department?        @relation(fields: [departmentId], references: [id])
  hod          Employee?          @relation("HODSuggestions", fields: [hodId], references: [id], onDelete: SetNull)
  committee    SteeringCommittee? @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  kaizen       Kaizen?            @relation(fields: [linkedKaizenId], references: [id], onDelete: SetNull)
  reviews      SuggestionReview[]
}

// Audit trail: every status change by a reviewer is recorded here
model SuggestionReview {
  id            String           @id @default(uuid())
  suggestionId  String
  reviewerId    String
  statusChanged SuggestionStatus
  note          String?
  createdAt     DateTime         @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  reviewer   Employee   @relation(fields: [reviewerId], references: [id])
}

// ── Calendar: Consultancy Visit Scheduling ────────────────────────────────────

enum RecurrencePattern {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// ── Holistic Calendar ─────────────────────────────────────────────────────────

// Google Calendar-style color swatches, freely chosen, no restriction on meaning
enum EventColor {
  TOMATO
  FLAMINGO
  TANGERINE
  BANANA
  SAGE
  BASIL
  PEACOCK
  BLUEBERRY
  LAVENDER
  GRAPE
  GRAPHITE
}

enum EventVisibility {
  PRIVATE // visible only to creator + invited guests
  ORG_WIDE // visible to every employee in the organization
}

enum EventRecurrencePattern {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum VisitStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VisitRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model CalendarEvent {
  id              String          @id @default(uuid())
  title           String
  description     String?
  label           String?
  color           EventColor      @default(PEACOCK)
  visibility      EventVisibility @default(PRIVATE)
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean         @default(false)
  organizationId  String
  createdById     String
  // Free-text prospect/company name — set only for "New Client Visit" quick-created
  // events (initial meetings with a company not yet onboarded as a Partner Organization)
  prospectOrgName String?

  // Recurrence
  isRecurring        Boolean                 @default(false)
  recurrencePattern  EventRecurrencePattern?
  recurrenceInterval Int                     @default(1)
  recurrenceEndAt    DateTime?
  parentEventId      String?

  organization Organization       @relation(fields: [organizationId], references: [id])
  createdBy    Employee           @relation("CalendarEventCreator", fields: [createdById], references: [id])
  invitations  EventInvitation[]
  participants EventParticipant[]
  parentEvent  CalendarEvent?     @relation("EventSeries", fields: [parentEventId], references: [id])
  childEvents  CalendarEvent[]    @relation("EventSeries")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startAt])
  @@index([createdById, startAt])
}

// Tracks meeting invites + accept/decline responses (also serves as the accept/reject log)
model EventInvitation {
  id          String           @id @default(uuid())
  eventId     String
  inviteeId   String
  status      InvitationStatus @default(PENDING)
  respondedAt DateTime?

  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitee Employee      @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, inviteeId])
  @@index([inviteeId, status])
}

// Assigned participants for training sessions and audits (no accept/decline flow)
model EventParticipant {
  id         String @id @default(uuid())
  eventId    String
  employeeId String

  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employee Employee      @relation("EventParticipations", fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([eventId, employeeId])
}

model ConsultancyVisit {
  id                String             @id @default(uuid())
  title             String
  clientOrgId       String
  date              DateTime
  endDate           DateTime?
  startTime         String?
  endTime           String?
  status            VisitStatus        @default(TENTATIVE)
  notes             String?
  internalNotes     String?
  completionNote    String?
  recurrencePattern RecurrencePattern?
  recurrenceEndDate DateTime?
  recurrenceGroupId String?
  rescheduleCount   Int                @default(0)
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  clientOrg     Organization    @relation(fields: [clientOrgId], references: [id])
  createdBy     User            @relation(fields: [createdById], references: [id])
  attendees     VisitAttendee[]
  sourceRequest VisitRequest?

  @@index([recurrenceGroupId])
}

model VisitMonthPlan {
  id          String   @id @default(uuid())
  clientOrgId String
  year        Int
  month       Int
  plannedDays Int      @default(1)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientOrg Organization    @relation(fields: [clientOrgId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  slots     VisitPlanSlot[]

  @@unique([clientOrgId, year, month])
}

model VisitPlanSlot {
  id        String    @id @default(uuid())
  planId    String
  slotIndex Int
  date      DateTime?
  agenda    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  plan VisitMonthPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, slotIndex])
}

model VisitRequest {
  id             String             @id @default(uuid())
  organizationId String
  requestedDate  DateTime
  preferredTime  String?
  message        String?
  status         VisitRequestStatus @default(PENDING)
  responseNote   String?
  visitId        String?            @unique
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  createdBy    User              @relation(fields: [createdById], references: [id])
  visit        ConsultancyVisit? @relation(fields: [visitId], references: [id])
}

model VisitAttendee {
  id         String  @id @default(uuid())
  visitId    String
  employeeId String
  role       String?

  visit    ConsultancyVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([visitId, employeeId])
}

enum CalendarBlockType {
  HOLIDAY
  BUSY_DAY
}

model CalendarBlock {
  id          String            @id @default(uuid())
  date        DateTime
  type        CalendarBlockType
  label       String?
  createdById String
  employeeId  String?
  createdAt   DateTime          @default(now())

  createdBy User      @relation(fields: [createdById], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// Google Calendar-style user-defined filters for the holistic calendar agenda
model CalendarFilter {
  id         String   @id @default(uuid())
  employeeId String
  name       String
  kinds      String[] @default([])
  orgIds     String[] @default([])
  colors     String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ── Leave Management ──────────────────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id                  String      @id @default(uuid())
  employeeId          String
  organizationId      String
  type                String
  status              LeaveStatus @default(PENDING)
  startDate           DateTime
  endDate             DateTime
  days                Int
  reason              String?
  handoverEmployeeId  String?
  handoverNotes       String?
  handoverEmployee2Id String?
  handoverNotes2      String?
  reviewedById        String?
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id])
  handoverEmployee  Employee?    @relation("LeaveHandover", fields: [handoverEmployeeId], references: [id], onDelete: SetNull)
  handoverEmployee2 Employee?    @relation("LeaveHandover2", fields: [handoverEmployee2Id], references: [id], onDelete: SetNull)
  reviewedBy        User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([organizationId, status])
  @@index([organizationId, startDate])
}

model LeaveBalance {
  id         String @id @default(uuid())
  employeeId String
  year       Int
  type       String
  allocated  Int    @default(0)
  used       Int    @default(0)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, type])
  @@index([employeeId, year])
}

model LeavePolicy {
  id             String   @id @default(uuid())
  organizationId String
  year           Int
  type           String
  allocated      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year, type])
  @@index([organizationId, year])
}

model LeaveSettings {
  id               String   @id @default(uuid())
  organizationId   String   @unique
  workingDays      Int[]    @default([1, 2, 3, 4, 5])
  enabledTypes     String[] @default([])
  customLeaveTypes Json     @default("[]")
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Notice {
  id             String    @id @default(cuid())
  organizationId String
  type           String    @default("INFO")
  title          String
  body           String
  pinned         Boolean   @default(false)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
}

model Task {
  id                       String         @id @default(uuid())
  title                    String
  frequency                TaskFrequency
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  assignedById             String?
  completionPercent        Int            @default(0)
  description              String?
  ownerId                  String
  status                   TaskStatus     @default(PENDING)
  acknowledgedAt           DateTime?
  completionNote           String?
  completionAttachmentUrl  String?
  completionAttachmentName String?
  dueDate                  DateTime?
  isAdhoc                  Boolean        @default(false)
  priority                 Priority?      @default(MEDIUM)
  departmentId             String?
  ownerName                String?
  assignedByName           String?
  approvedById             String?
  overdueAlertTo           OverdueAlertTo @default(ASSIGNER)
  backupOwnerId            String?
  assignedBy               Employee?      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  owner                    Employee       @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  approvedBy               Employee?      @relation("TaskApprovedBy", fields: [approvedById], references: [id])
  backupOwner              Employee?      @relation("TaskBackupOwner", fields: [backupOwnerId], references: [id])
  instances                TaskInstance[]
  department               Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([assignedById])
  @@index([departmentId])
  @@index([approvedById])
  @@index([backupOwnerId])
}

model TaskInstance {
  id                String        @id @default(uuid())
  taskId            String
  ownerId           String
  frequency         TaskFrequency
  scheduledFor      DateTime
  dueAt             DateTime
  status            TaskStatus    @default(PENDING)
  completionPercent Int           @default(0)
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  owner             Employee      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  task              Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  alerts            Alert[]

  @@unique([taskId, scheduledFor])
  @@index([ownerId, frequency])
  @@index([ownerId, scheduledFor])
  @@index([taskId])
}

model Alert {
  id               String      @id @default(uuid())
  type             AlertType
  title            String
  description      String
  raisedById       String
  organizationId   String?
  severity         Severity
  status           AlertStatus @default(OPEN)
  correctiveAction String?
  closureNote      String?
  resolvedAt       DateTime?
  taskInstanceId   String?
  departmentId     String?
  againstUserId    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  raisedBy     Employee      @relation("AlertsRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskInstance TaskInstance? @relation(fields: [taskInstanceId], references: [id], onDelete: SetNull)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  againstUser  Employee?     @relation("AlertsAgainst", fields: [againstUserId], references: [id], onDelete: SetNull)

  @@index([raisedById])
  @@index([organizationId])
  @@index([taskInstanceId])
  @@index([departmentId])
  @@index([againstUserId])
}

enum AlertType {
  BREAKDOWN
  DELAY
  QUALITY_ISSUE
  WRONG_ENTRY
  WRONG_DELIVERY
  SAFETY_CONCERN
  PROCESS_DEVIATION
  MISSED_ACTIVITY
  REPEATED_PROBLEM
  DISCIPLINE_ISSUE
  ABNORMAL_SITUATION
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ESCALATED
}

enum TaskFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  PLANNED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  APPROVAL_PENDING
  PARTLY_DONE
  LESS_THAN_50
  NOT_APPLICABLE
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OverdueAlertTo {
  ASSIGNER
  MANAGER
}

enum ViewLevel {
  OWN
  DEPARTMENT
  ORGANIZATION
}

enum EscalationContactRule {
  ASSIGNER
  MANAGER
  HOD
  HIGHER_LEVEL_MANAGERS
  CUSTOM
}

enum TaskPermissionRole {
  ADMIN
  MANAGEMENT
  HOD
  DIRECT_MANAGER
  HIGHER_LEVEL_MANAGERS
  OWNER
  ANYONE
  CUSTOM
}

model DwmsPermissionConfig {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  approverRoles             TaskPermissionRole[] @default([])
  approverCustomEmployeeIds String[]             @default([])

  alertViewLevel     ViewLevel @default(OWN)
  analyticsViewLevel ViewLevel @default(DEPARTMENT)

  escalateUnacknowledgedMediumMins   Int                     @default(1440)
  escalateUnacknowledgedHighMins     Int                     @default(480)
  escalateUnacknowledgedCriticalMins Int                     @default(120)
  escalateUnacknowledgedMins         Int                     @default(60)
  escalationContactRules             EscalationContactRule[] @default([])
  customEscalationContactIds         String[]                @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// DAILY GEMBA KAIZEN

enum KaizenStatus {
  DRAFT
  PENDING_HOD_PRE_REVIEW
  RETURNED_FOR_REVISION
  REJECTED
  MOVED_TO_SGA
  IN_IMPLEMENTATION
  PENDING_VERIFICATION
  RETURNED_FOR_REWORK
  VERIFIED_CLOSED
}

enum KaizenTrigger {
  PROBLEM_NOTICED
  IMPROVEMENT_OPPORTUNITY_NOTICED
  ALERT_ACTION_REQUIRED
  ABNORMALITY_ACTION_REQUIRED
  EMPLOYEE_SUGGESTION_OR_IDEA
  AUDIT_OBSERVATION
  GEMBA_WALK_OBSERVATION
  CUSTOMER_COMPLAINT_OR_FEEDBACK
  MANAGEMENT_INSTRUCTION_OR_FEEDBACK
  REPEAT_PROBLEM
  OTHER
}

enum KaizenReferenceApplicability {
  APPLICABLE
  NOT_APPLICABLE
  REFERENCE_NOT_FOUND
}

enum KaizenQcdsmtCategory {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
}

enum KaizenUnit {
  SECONDS
  HOURS
  MINUTES
  PIECES
  KILOGRAMS
  TONNES
  METRES
  LITRES
  PERCENTAGE
  CURRENCY
  OTHER
}

enum KaizenWaste {
  TRANSPORTATION
  INVENTORY
  MOTION
  WAITING
  OVERPRODUCTION
  OVERPROCESSING
  DEFECTS
  NOT_APPLICABLE
}

enum KaizenHodPreReviewDecision {
  PENDING
  APPROVE
  RETURN
  REJECT
  MOVE_TO_SGA
}

enum KaizenVerificationStage {
  HOD
  STEERING_COMMITTEE
  FINANCE
}

enum KaizenVerificationDecision {
  PENDING
  VERIFIED
  RETURN
  NOT_APPLICABLE
}

model Kaizen {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  departmentId   String
  status         KaizenStatus @default(DRAFT)

  // Part 1: reason
  title        String?
  trigger      KaizenTrigger?
  triggerOther String?

  // Part 2: related reference
  referenceValue         String?
  referenceApplicability KaizenReferenceApplicability?

  // Part 3: condition or opportunity
  conditionDescription  String
  conditionEvidenceUrls String[] @default([])

  // Part 4: basic daily kaizen information
  startDate            DateTime?
  targetCompletionDate DateTime?
  kaizenOwnerId        String?

  // Part 7: required material and estimated cost
  requiredMaterials     String?
  estimatedCost         Decimal? @db.Decimal(14, 2)
  estimatedCostCurrency String?

  // Part 8: HOD review before implementation
  hodPreReviewDecision KaizenHodPreReviewDecision @default(PENDING)
  hodPreReviewRemarks  String?
  hodPreReviewById     String?
  hodPreReviewAt       DateTime?

  // Part 9: implementation and evidence
  actionTaken    String?
  afterPhotoUrls String[] @default([])
  resultSaving   String?

  linkedSgaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id])
  employee         Employee             @relation("KaizenRaisedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  department       Department?          @relation(fields: [departmentId], references: [id])
  kaizenOwner      Employee?            @relation("KaizenOwner", fields: [kaizenOwnerId], references: [id], onDelete: SetNull)
  hodPreReviewBy   Employee?            @relation("KaizenHodPreReviewBy", fields: [hodPreReviewById], references: [id], onDelete: SetNull)
  teamMembers      Employee[]           @relation("KaizenTeamMembers")
  reviews          KaizenReview[]
  qcdsmtImpacts    KaizenQcdsmtImpact[]
  wasteImpacts     KaizenWasteImpact[]
  verifications    KaizenVerification[]
  sourceSuggestion Suggestion?

  @@index([organizationId, status])
  @@index([employeeId, createdAt])
  @@index([kaizenOwnerId])
  @@index([departmentId, status])
}

model KaizenQcdsmtImpact {
  id             String               @id @default(uuid())
  kaizenId       String
  category       KaizenQcdsmtCategory
  whatIsMeasured String
  beforeValue    String?
  afterValue     String?
  unit           KaizenUnit
  otherUnitLabel String?
  currency       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  kaizen Kaizen @relation(fields: [kaizenId], references: [id], onDelete: Cascade)

  @@unique([kaizenId, category])
  @@index([kaizenId])
}

model KaizenWasteImpact {
  id             String      @id @default(uuid())
  kaizenId       String
  waste          KaizenWaste
  whatIsMeasured String
  beforeValue    String?
  afterValue     String?
  unit           KaizenUnit
  otherUnitLabel String?
  currency       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  kaizen Kaizen @relation(fields: [kaizenId], references: [id], onDelete: Cascade)

  @@unique([kaizenId, waste])
  @@index([kaizenId])
}

model KaizenVerification {
  id                      String                     @id @default(uuid())
  kaizenId                String
  stage                   KaizenVerificationStage
  decision                KaizenVerificationDecision @default(PENDING)
  remarks                 String?
  verifiedBenefitAmount   Decimal?                   @db.Decimal(14, 2)
  verifiedBenefitCurrency String?
  verifiedById            String?
  verifiedAt              DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  kaizen     Kaizen    @relation(fields: [kaizenId], references: [id], onDelete: Cascade)
  verifiedBy Employee? @relation("KaizenVerificationBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@unique([kaizenId, stage])
  @@index([kaizenId])
}

model KaizenReview {
  id            String       @id @default(uuid())
  kaizenId      String
  reviewerId    String
  statusChanged KaizenStatus
  note          String?
  createdAt     DateTime     @default(now())

  kaizen   Kaizen   @relation(fields: [kaizenId], references: [id], onDelete: Cascade)
  reviewer Employee @relation(fields: [reviewerId], references: [id])
}
