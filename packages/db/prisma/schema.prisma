generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ModuleType {
  SIMS
}

enum CommitteeType {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
  GENERAL
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGEMENT
  HR
  HOD
  EMPLOYEE
}

//organization
model Organization {
  id          String    @id @default(uuid())
  name        String
  logoUrl     String?
  industry    String?
  email       String?
  phone       String?
  address     String?
  status      OrgStatus  @default(ACTIVE)
  modules     ModuleType[] @default([])
  primaryColor String?    @default("#4F46E5")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userOrganizations UserOrganization[]
  employees   Employee[]
  departments Department[]
  suggestions Suggestion[]
  committees  SteeringCommittee[]
}

//specific user
model User {
  id                String @id @default(uuid())
  email             String? @unique
  phone             String
  password          String?
  name              String

  organizations     UserOrganization[]
  employees         Employee[]

  createdAt         DateTime @default(now())
}

model UserOrganization {
  userId         String
  organizationId String
  roleId         Int

  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@id([userId, organizationId])
}

model Role {
  id                Int @id
  name              RoleName @unique

  userOrganizations UserOrganization[]
  permissions       RolePermission[]
}

model Permission {
  id                String @id @default(uuid())
  name              String @unique
  description       String?

  roles             RolePermission[]
}


model RolePermission {
  roleId       Int
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Employee {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  departmentId   String?
  organizationId String
  userId         String?
  avatarUrl      String?

  department       Department?  @relation(fields: [departmentId], references: [id])
  organization     Organization @relation(fields: [organizationId], references: [id])
  user             User?        @relation(fields: [userId], references: [id])
  suggestions      Suggestion[]
  suggestionReviews SuggestionReview[]
  committeeMembers  SteeringCommitteeMember[]

  createdAt      DateTime @default(now())

  @@unique([email, organizationId])
  @@unique([phone, organizationId])
}


model Department {
  id             String   @id @default(uuid())
  name           String
  organizationId String

  employees      Employee[]
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model SteeringCommittee {
  id             String        @id @default(uuid())
  name           String
  type           CommitteeType
  organizationId String
  createdAt      DateTime      @default(now())

  organization   Organization              @relation(fields: [organizationId], references: [id])
  members        SteeringCommitteeMember[]
  suggestions    Suggestion[]
  reviews        SuggestionReview[]
}

model SteeringCommitteeMember {
  committeeId  String
  employeeId   String

  committee    SteeringCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([committeeId, employeeId])
}

// SIMS: Suggestions and Idea Management System

enum SuggestionStatus {
  UNDER_REVIEW
  NEEDS_CLARIFICATION
  APPROVED
  REJECTED
  IMPLEMENTED
  ARCHIVED
}

enum SuggestionCategory {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
  UNKNOWN
}

model Suggestion {
  id             String               @id @default(uuid())
  title          String
  description    String
  status         SuggestionStatus     @default(UNDER_REVIEW)
  categories     SuggestionCategory[] @default([])
  isAnonymous    Boolean              @default(false)
  employeeId     String
  organizationId String
  committeeId    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  employee       Employee              @relation(fields: [employeeId], references: [id])
  organization   Organization          @relation(fields: [organizationId], references: [id])
  committee      SteeringCommittee?    @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  reviews        SuggestionReview[]
}

// Audit trail: every status change by a committee member is recorded here
model SuggestionReview {
  id                  String           @id @default(uuid())
  suggestionId        String
  reviewerId          String
  reviewerCommitteeId String?
  statusChanged       SuggestionStatus
  note                String?
  createdAt           DateTime         @default(now())

  suggestion          Suggestion         @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  reviewer            Employee           @relation(fields: [reviewerId], references: [id])
  reviewerCommittee   SteeringCommittee? @relation(fields: [reviewerCommitteeId], references: [id], onDelete: SetNull)
}
