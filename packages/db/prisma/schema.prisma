generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum QuoteCategory {
  MOTIVATION
  PRODUCTIVITY
  WELLNESS
  CODING
  LEADERSHIP
  STUDY
}

enum ModuleType {
  SIMS
  EMS
  CALENDAR
  LEAVE
}

enum CommitteeType {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
  GENERAL
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGEMENT
  HR
  HOD
  EMPLOYEE
}

enum NotificationType {
  ACTION_REQUIRED // user must do something
  INFO            // information update
  REMINDER        // time based nudge
  ALERT           // urgent/system-lever
}

// EMS: Employee Master Data
enum EmploymentStatus {
  ACTIVE
  PROBATION
  RESIGNED
  TERMINATED
  RETIRED
  SUSPENDED
  ABSCONDED
  CONTRACT_ENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SkillLevel {
  LEVEL_1 // Learner
  LEVEL_2 // Can Work with Support
  LEVEL_3 // Can Work Independently
  LEVEL_4 // Can Train Others
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CASUAL
}

//organization
model Organization {
  id          String    @id @default(uuid())
  name        String
  logoUrl     String?
  industry    String?
  email       String?
  phone       String?
  address     String?
  status      OrgStatus  @default(ACTIVE)
  modules     ModuleType[] @default([])
  primaryColor String?    @default("#4F46E5")
  isAdminOrg  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  userOrganizations UserOrganization[]
  employees   Employee[]
  departments Department[]
  suggestions Suggestion[]
  committees  SteeringCommittee[]
  consultancyVisits ConsultancyVisit[]
  visitRequests     VisitRequest[]
  leaveRequests     LeaveRequest[]
}

//specific user
model User {
  id                String @id @default(uuid())
  email             String? @unique
  phone             String  @unique
  password          String?
  name              String

  organizations     UserOrganization[]
  employees         Employee[]
  createdVisits     ConsultancyVisit[]
  visitRequests     VisitRequest[]
  calendarBlocks    CalendarBlock[]
  refreshTokens     RefreshToken[]
  reviewedLeaves    LeaveRequest[]    @relation("LeaveReviewer")

  createdAt         DateTime @default(now())
}

model RefreshToken {
  id             String   @id @default(uuid())
  tokenHash      String   @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserOrganization {
  userId         String
  organizationId String
  roleId         Int

  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@id([userId, organizationId])
}

model Role {
  id                Int @id
  name              RoleName @unique

  userOrganizations UserOrganization[]
  permissions       RolePermission[]
}

model Permission {
  id                String @id @default(uuid())
  name              String @unique
  description       String?

  roles             RolePermission[]
}


model RolePermission {
  roleId       Int
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Employee {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  departmentId   String?
  organizationId String
  userId         String?
  avatarUrl      String?

  // EMS: Identity group
  employeeCode   String?
  middleName     String?
  gender         Gender?
  dateOfBirth    DateTime?
  nationalId     String?
  nationality    String?

  // EMS: Work Allocation group
  employmentStatus EmploymentStatus @default(ACTIVE)
  employmentType   EmploymentType?
  jobTitle         String?
  dateJoined       DateTime?
  workStation      String?
  section          String?
  subSection       String?
  shift            String?
  reportingManagerId String?
  reportingManager   Employee?  @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports      Employee[] @relation("ReportingManager")

  // EMS: Role & Responsibility group
  jobDescription     String?
  level              String?
  grade              String?
  jobCategory        String?
  primaryWorkRole    String?
  machineProcess     String?
  canBeAssignedTasks Boolean @default(true)
  canBeMember        Boolean @default(true)
  canBeLeader        Boolean @default(false)

  // EMS: Contact group (phone + email above; extras below)
  whatsappNumber               String?
  homeAddress                  String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  // EMS: Skill group
  skillLevel     SkillLevel?
  trainingNeeded Boolean?

  // EMS: Record control
  hrRecordOwnerId    String?
  hrRecordOwner      Employee?  @relation("HRRecordOwner", fields: [hrRecordOwnerId], references: [id], onDelete: SetNull)
  hrManagedEmployees Employee[] @relation("HRRecordOwner")

  department        Department?  @relation(fields: [departmentId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])
  user              User?        @relation(fields: [userId], references: [id])
  suggestions       Suggestion[] @relation("EmployeeSuggestions")
  hodSuggestions    Suggestion[] @relation("HODSuggestions")
  suggestionReviews SuggestionReview[]
  committeeMembers  SteeringCommitteeMember[]
  notifications     Notification[]
  visitAttendances  VisitAttendee[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([email, organizationId])
  @@unique([phone, organizationId])
}


model Department {
  id             String   @id @default(uuid())
  name           String
  organizationId String

  employees      Employee[]
  organization   Organization @relation(fields: [organizationId], references: [id])
  suggestions    Suggestion[]
}

model SteeringCommittee {
  id             String        @id @default(uuid())
  name           String
  type           CommitteeType
  organizationId String
  createdAt      DateTime      @default(now())

  organization   Organization              @relation(fields: [organizationId], references: [id])
  members        SteeringCommitteeMember[]
}

model SteeringCommitteeMember {
  committeeId     String
  employeeId      String
  roleInCommittee String?

  committee    SteeringCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([committeeId, employeeId])
}

model Quotes {
  id          String  @id @default(uuid())
  text        String

  category    QuoteCategory?
  mood        String?

  timeOfDay   TimeOfDay[]
  tags        String[]

  author      String
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("quotes")
}

model Notification {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        NotificationType
  module      String    // "SIMS", "LEAVE", "ATTENDANCE", "HR"
  title       String
  message     String
  isRead      Boolean   @default(false)
  actionUrl   String?
  metadata    Json?     // any extra structured data the module wants to attach
  createdAt  DateTime   @default(now())

  @@index([employeeId, isRead])
  @@index([employeeId, createdAt])
  @@index([employeeId, module])
}

// SIMS: Suggestions and Idea Management System

enum SuggestionStatus {
  UNDER_REVIEW
  APPROVED_FOR_IMPLEMENTATION
  REJECTED
  ON_HOLD
  SELECTED_FOR_SGA
}

enum ImplementationStatus {
  WORK_IN_PROGRESS
  VERY_SLOW_WORK_IN_PROGRESS
  GOOD_WORK_IN_PROGRESS
  SLOW_PROGRESS
  IMPLEMENTED
  SHIFTED_TO_SGA
  PREVIOUSLY_IMPLEMENTED
  UNDER_CONSULTATION
  IMPRACTICAL
  SAVED_FOR_LATER
}

enum SuggestionCategory {
  QUALITY
  COST
  DELIVERY
  SAFETY
  MORALE
  TECHNOLOGY
  UNKNOWN
}

model Suggestion {
  id                   String                @id @default(uuid())
  title                String
  description          String
  imageUrl             String?
  status               SuggestionStatus      @default(UNDER_REVIEW)
  implementationStatus ImplementationStatus?
  implementationNote   String?
  categories           SuggestionCategory[]  @default([])
  isAnonymous          Boolean               @default(false)
  employeeId           String
  organizationId       String
  departmentId         String?
  hodId                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  employee     Employee           @relation("EmployeeSuggestions", fields: [employeeId], references: [id])
  organization Organization       @relation(fields: [organizationId], references: [id])
  department   Department?        @relation(fields: [departmentId], references: [id])
  hod          Employee?          @relation("HODSuggestions", fields: [hodId], references: [id], onDelete: SetNull)
  reviews      SuggestionReview[]
}

// Audit trail: every status change by a reviewer is recorded here
model SuggestionReview {
  id                  String           @id @default(uuid())
  suggestionId        String
  reviewerId          String
  statusChanged       SuggestionStatus
  note                String?
  createdAt           DateTime         @default(now())

  suggestion          Suggestion         @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  reviewer            Employee           @relation(fields: [reviewerId], references: [id])
}

// ── Calendar: Consultancy Visit Scheduling ────────────────────────────────────

enum RecurrencePattern {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum VisitStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum VisitRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ConsultancyVisit {
  id                 String              @id @default(uuid())
  title              String
  clientOrgId        String
  date               DateTime
  endDate            DateTime?
  startTime          String?
  endTime            String?
  status             VisitStatus         @default(TENTATIVE)
  notes              String?
  internalNotes      String?
  completionNote     String?
  recurrencePattern  RecurrencePattern?
  recurrenceEndDate  DateTime?
  recurrenceGroupId  String?
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  clientOrg          Organization        @relation(fields: [clientOrgId], references: [id])
  createdBy          User                @relation(fields: [createdById], references: [id])
  attendees          VisitAttendee[]

  @@index([recurrenceGroupId])
}

model VisitRequest {
  id              String             @id @default(uuid())
  organizationId  String
  requestedDate   DateTime
  preferredTime   String?
  message         String?
  status          VisitRequestStatus @default(PENDING)
  responseNote    String?
  createdById     String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  createdBy       User         @relation(fields: [createdById], references: [id])
}

model VisitAttendee {
  id         String           @id @default(uuid())
  visitId    String
  employeeId String
  role       String?

  visit      ConsultancyVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([visitId, employeeId])
}

enum CalendarBlockType {
  HOLIDAY
  BUSY_DAY
}

model CalendarBlock {
  id          String            @id @default(uuid())
  date        DateTime
  type        CalendarBlockType
  label       String?
  createdById String
  createdAt   DateTime          @default(now())

  createdBy   User              @relation(fields: [createdById], references: [id])
}

// ── Leave Management ──────────────────────────────────────────────────────────

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  PATERNITY
  COMPASSIONATE
  STUDY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id             String      @id @default(uuid())
  employeeId     String
  organizationId String
  type           LeaveType
  status         LeaveStatus @default(PENDING)
  startDate      DateTime
  endDate        DateTime
  days           Int
  reason         String?
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  reviewedBy   User?        @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([organizationId, status])
  @@index([organizationId, startDate])
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  year        Int
  type        LeaveType
  allocated   Int       @default(0)
  used        Int       @default(0)

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year, type])
  @@index([employeeId, year])
}
   