// DAILY GEMBA KAIZEN

enum KaizenStatus {
  DRAFT
  IN_PROGRESS
  SUBMITTED_FOR_VERIFICATION
  VERIFIED_CLOSED
  FURTHER_IMPROVEMENT_REQUIRED
  MOVED_TO_SGA
}

model Kaizen {
  id             String       @id @default(uuid())
  organizationId String
  employeeId     String
  departmentId   String
  status         KaizenStatus @default(DRAFT)

  problem                String
  beforePhotoUrl         String
  improvementDescription String?
  afterPhotoUrl          String?
  benefitAchieved        String?

  teamMembers     String?
  benefitCategory String?
  beforeValue     String?
  afterValue      String?
  costSaving      String?
  comments        String?

  verifiedById        String?
  verificationComment String?
  standardUpdated     Boolean?
  linkedSgaId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id])
  employee         Employee       @relation("KaizenRaisedBy", fields: [employeeId], references: [id], onDelete: Cascade)
  department       Department?    @relation(fields: [departmentId], references: [id])
  verifiedBy       Employee?      @relation("KaizenVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  reviews          KaizenReview[]
  sourceSuggestion Suggestion?

  @@index([organizationId, status])
  @@index([employeeId, createdAt])
}

model KaizenReview {
  id            String       @id @default(uuid())
  kaizenId      String
  reviewerId    String
  statusChanged KaizenStatus
  note          String?
  createdAt     DateTime     @default(now())

  kaizen   Kaizen   @relation(fields: [kaizenId], references: [id], onDelete: Cascade)
  reviewer Employee @relation(fields: [reviewerId], references: [id])
}
