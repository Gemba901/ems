// Approved supplier master — checked at P02-A03/A04, referenced by every sourcing order.
model Supplier {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  code           String?
  materialTypes  SteelMaterialType[]    @default([])
  approvalStatus SupplierApprovalStatus @default(PENDING)
  rejectionCount Int                    @default(0)
  qualityScore   Float?
  deliveryScore  Float?
  contactPerson  String?
  phone          String?
  email          String?
  country        String?
  isImportSource Boolean                @default(false)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization             @relation(fields: [organizationId], references: [id])
  sourcingOrders SteelSourcingOrder[]
  quotations     SteelSourcingQuotation[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, approvalStatus])
}

// One record per material requirement sourced against a released production plan,
// carried through P02-A01 -> P02-A12.
model SteelSourcingOrder {
  id             String              @id @default(uuid())
  sourcingNumber String              @unique
  organizationId String
  planId         String
  createdById    String
  stage          SteelSourcingStage  @default(A01_REQUIREMENT_REVIEWED)
  status         SteelSourcingStatus @default(DRAFT)

  // P02-A01 — Review material requirement from production plan
  materialRequirementNotes String?
  requiredByDate           DateTime?

  // P02-A02 — Identify material type needed
  materialType      SteelMaterialType?
  materialTypeNotes String?

  // P02-A03 — Check approved supplier list
  supplierId                String?
  supplierApprovalConfirmed Boolean?
  supplierCheckNotes        String?

  // P02-A04 — Check supplier quality and rejection history
  supplierRiskLevel     SupplierRiskLevel?
  rejectionRateNotes    String?
  complaintHistoryNotes String?

  // P02-A05 — Collect price and availability confirmation (see SteelSourcingQuotation)
  quotationsCollectedAt DateTime?

  // P02-A06 — Compare supplier options using QCD logic
  selectedSupplierId String?
  qcdComparisonNotes String?

  // P02-A07 — Confirm technical specification and documents required
  specificationRequirementNotes String?
  certificateRequired           Boolean?
  documentsRequired             String[] @default([])

  // P02-A08 — Create purchase order
  poNumber        String?
  poItem          String?
  poQuantity      Float?
  poPrice         Float?
  poCurrency      String?
  poDeliveryTerms String?
  poCreatedAt     DateTime?

  // P02-A09 — Confirm delivery schedule with supplier
  confirmedDispatchDate DateTime?
  confirmedArrivalDate  DateTime?
  vehicleContainerInfo  String?

  // P02-A10 — Prepare import/local logistics if applicable (Imported Billet Route)
  billOfLading         String?
  countryOfOrigin      String?
  portClearanceStatus  String?
  importLogisticsNotes String?

  // P02-A11 — Inform raw material intake team
  intakeInformedAt  DateTime?
  intakeNotifyNotes String?

  // P02-A12 — Close sourcing handover to intake
  handoverClosedAt DateTime?
  handoverNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization               @relation(fields: [organizationId], references: [id])
  plan            SteelProductionPlan        @relation(fields: [planId], references: [id])
  createdBy       Employee                   @relation("SteelSourcingCreatedBy", fields: [createdById], references: [id])
  supplier        Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quotations      SteelSourcingQuotation[]
  activityLogs    SteelSourcingActivityLog[]
  materialIntakes SteelMaterialIntake[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, status])
  @@index([planId])
}

// P02-A05: one quotation per supplier considered, used for the P02-A06 QCD comparison.
model SteelSourcingQuotation {
  id                String    @id @default(uuid())
  sourcingId        String
  supplierId        String
  price             Float
  currency          String    @default("USD")
  quantityAvailable Float?
  deliveryDate      DateTime?
  paymentTerms      String?
  qualityRiskNotes  String?
  createdAt         DateTime  @default(now())

  order    SteelSourcingOrder @relation(fields: [sourcingId], references: [id], onDelete: Cascade)
  supplier Supplier           @relation(fields: [supplierId], references: [id])

  @@index([sourcingId])
}

// Audit trail: every activity performed against a sourcing order is recorded here
model SteelSourcingActivityLog {
  id            String                @id @default(uuid())
  sourcingId    String
  activity      SteelSourcingActivity
  performedById String
  notes         String?
  data          Json?
  createdAt     DateTime              @default(now())

  order       SteelSourcingOrder @relation(fields: [sourcingId], references: [id], onDelete: Cascade)
  performedBy Employee           @relation("SteelSourcingPerformedBy", fields: [performedById], references: [id])

  @@index([sourcingId])
}

model SteelProductionPlan {
  id             String                 @id @default(uuid())
  planNumber     String                 @unique
  organizationId String
  createdById    String
  stage          SteelPlanStage         @default(A01_DEMAND_CAPTURED)
  status         SteelPlanOverallStatus @default(DRAFT)

  // P01-A01 — Capture customer enquiry, sales order, forecast, or stock requirement
  demandSource              DemandSource
  customerName              String?
  dealerName                String?
  projectReference          String?
  salesOrderNumber          String?
  forecastReference         String?
  stockRequirementReference String?
  expectedDeliveryDate      DateTime?
  requestedQuantityTonnes   Float
  demandNotes               String?

  // P01-A02 — Confirm customer and order priority
  priority            OrderPriority?
  deliveryPromiseDate DateTime?
  creditStatus        CreditStatus?

  // P01-A03 — Confirm product type and standard required
  productType           ProductType?
  productStandard       String?
  customerSpecification String?

  // P01-A04 — Confirm grade, size, length, bundle, and quantity
  grade          String?
  size           String?
  length         String?
  bundleType     String?
  totalQuantity  Float?
  toleranceNotes String?

  // P01-A05 — Check certified finished goods stock
  certifiedStockAvailableQty Float?
  stockBundleIds             String[] @default([])
  stockHeatNumbers           String[] @default([])
  stockCertificateRefs       String[] @default([])

  // P01-A06 — Decide dispatch from stock or production required
  stockDecision      StockDecision?
  stockDecisionNotes String?

  // P01-A07 — Select applicable plant route
  plantRoute PlantRoute?
  routeNotes String?

  // P01-A08 — Check raw material or billet availability
  materialAvailability     AvailabilityStatus?
  materialShortageNotes    String?
  purchaseRequirementNotes String?

  // P01-A09 — Check equipment, maintenance, and manpower availability
  equipmentAvailability    AvailabilityStatus?
  manpowerAvailability     AvailabilityStatus?
  maintenanceShutdownNotes String?
  shiftPlanNotes           String?

  // P01-A10 — Prepare production plan and sequence
  productionSequence Json?
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  planNotes          String?

  // P01-A11 — Communicate plan to all concerned departments
  planCommunicatedAt DateTime?

  // P01-A12 — Release approved production plan
  approvedById String?
  approvedAt   DateTime?
  releaseNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization             @relation(fields: [organizationId], references: [id])
  createdBy      Employee                 @relation("SteelPlanCreatedBy", fields: [createdById], references: [id])
  approvedBy     Employee?                @relation("SteelPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  activityLogs   SteelPlanActivityLog[]
  departmentAcks SteelPlanDepartmentAck[]
  sourcingOrders SteelSourcingOrder[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, status])
}

// Audit trail: every activity performed against a plan is recorded here
model SteelPlanActivityLog {
  id            String            @id @default(uuid())
  planId        String
  activity      SteelPlanActivity
  performedById String
  notes         String?
  data          Json?
  createdAt     DateTime          @default(now())

  plan        SteelProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  performedBy Employee            @relation(fields: [performedById], references: [id])

  @@index([planId])
}

// P01-A11: department acknowledgement of the communicated plan
model SteelPlanDepartmentAck {
  id               String          @id @default(uuid())
  planId           String
  department       SteelDepartment
  acknowledged     Boolean         @default(false)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  notes            String?
  createdAt        DateTime        @default(now())

  plan           SteelProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  acknowledgedBy Employee?           @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([planId, department])
  @@index([planId])
}

// One record per delivery received against a sourcing order, carried through P03-A01 -> P03-A14.
model SteelMaterialIntake {
  id              String            @id @default(uuid())
  intakeNumber    String            @unique
  organizationId  String
  sourcingOrderId String
  createdById     String
  stage           SteelIntakeStage  @default(A01_GATE_ARRIVAL_RECORDED)
  status          SteelIntakeStatus @default(DRAFT)

  // P03-A01 — Record truck/container arrival at gate
  vehicleNumber   String
  driverName      String?
  transporterName String?
  arrivalDateTime DateTime?
  gateEntryRef    String?

  // P03-A02 — Verify purchase order and delivery documents
  purchaseOrderVerified     Boolean?
  deliveryDocumentRef       String?
  documentVerificationNotes String?

  // P03-A03 — Send vehicle to weighbridge for gross weight
  grossWeightTonnes Float?
  grossWeighedAt    DateTime?

  // P03-A04 — Perform basic safety and access check
  safetyCheckPassed Boolean?
  safetyCheckNotes  String?

  // P03-A05 — Assign unloading or inspection area
  unloadingArea String?

  // P03-A06 — Carry out visual inspection of material
  visualInspectionNotes String?

  // P03-A07 — Check scrap hazard and contamination
  hazardOrContaminationFound Boolean?
  hazardNotes                String?

  // P03-A08 — Perform radiation check if required
  radiationCheckRequired Boolean?
  radiationCheckPassed   Boolean?

  // P03-A09 — Verify billet certificate, heat number, and grade if billet received
  materialType   SteelMaterialType?
  grade          String?
  heatNumber     String?
  certificateRef String?

  // P03-A10 — Decide accept, hold, or reject material
  acceptanceDecision MaterialAcceptanceDecision?
  decisionNotes      String?

  // P03-A11 — Unload approved material safely
  unloadedAt DateTime?

  // P03-A12 — Capture tare weight and net weight
  tareWeightTonnes Float?
  netWeightTonnes  Float?
  weighedAt        DateTime?

  // P03-A13 — Store material in correct yard location
  yardLocation String?
  storedAt     DateTime?

  // P03-A14 — Update stock and release for preparation/use
  stockReleasedAt   DateTime?
  stockReleaseNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization                     @relation(fields: [organizationId], references: [id])
  sourcingOrder SteelSourcingOrder               @relation(fields: [sourcingOrderId], references: [id])
  createdBy     Employee                         @relation("SteelIntakeCreatedBy", fields: [createdById], references: [id])
  activityLogs  SteelMaterialIntakeActivityLog[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, status])
  @@index([sourcingOrderId])
  @@index([createdAt])
}

// Audit trail: every activity performed against a material intake is recorded here
model SteelMaterialIntakeActivityLog {
  id            String              @id @default(uuid())
  intakeId      String
  activity      SteelIntakeActivity
  performedById String
  notes         String?
  data          Json?
  createdAt     DateTime            @default(now())

  intake      SteelMaterialIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  performedBy Employee            @relation("SteelIntakePerformedBy", fields: [performedById], references: [id])

  @@index([intakeId])
}

model Task {
  id                       String         @id @default(uuid())
  title                    String
  frequency                TaskFrequency
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  assignedById             String?
  completionPercent        Int            @default(0)
  description              String?
  ownerId                  String
  status                   TaskStatus     @default(PENDING)
  acknowledgedAt           DateTime?
  completionNote           String?
  completionAttachmentUrl  String?
  completionAttachmentName String?
  dueDate                  DateTime?
  isAdhoc                  Boolean        @default(false)
  priority                 Priority?      @default(MEDIUM)
  departmentId             String?
  ownerName                String?
  assignedByName           String?
  approvedById             String?
  overdueAlertTo           OverdueAlertTo @default(ASSIGNER)
  backupOwnerId            String?
  assignedBy               Employee?      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  owner                    Employee       @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  approvedBy               Employee?      @relation("TaskApprovedBy", fields: [approvedById], references: [id])
  backupOwner              Employee?      @relation("TaskBackupOwner", fields: [backupOwnerId], references: [id])
  instances                TaskInstance[]
  department               Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([assignedById])
  @@index([departmentId])
  @@index([approvedById])
  @@index([backupOwnerId])
}

model TaskInstance {
  id                String        @id @default(uuid())
  taskId            String
  ownerId           String
  frequency         TaskFrequency
  scheduledFor      DateTime
  dueAt             DateTime
  status            TaskStatus    @default(PENDING)
  completionPercent Int           @default(0)
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  owner             Employee      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  task              Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  alerts            Alert[]

  @@unique([taskId, scheduledFor])
  @@index([ownerId, frequency])
  @@index([ownerId, scheduledFor])
  @@index([taskId])
}

model Alert {
  id               String      @id @default(uuid())
  type             AlertType
  title            String
  description      String
  raisedById       String
  organizationId   String?
  severity         Severity
  status           AlertStatus @default(OPEN)
  correctiveAction String?
  closureNote      String?
  resolvedAt       DateTime?
  taskInstanceId   String?
  departmentId     String?
  againstUserId    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  raisedBy     Employee      @relation("AlertsRaised", fields: [raisedById], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskInstance TaskInstance? @relation(fields: [taskInstanceId], references: [id], onDelete: SetNull)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  againstUser  Employee?     @relation("AlertsAgainst", fields: [againstUserId], references: [id], onDelete: SetNull)

  @@index([raisedById])
  @@index([organizationId])
  @@index([taskInstanceId])
  @@index([departmentId])
  @@index([againstUserId])
}

enum AlertType {
