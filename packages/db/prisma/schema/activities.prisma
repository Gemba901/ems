model Activity {
  id                            String         @id @default(uuid())
  organizationId                String
  companyUnitName               String?
  mainDepartmentId              String?
  subDepartment                 String?
  gembaSection                  String?
  processArea                   String?
  name                          String
  workMethod                    String?
  code                          String
  purpose                       String?
  category                      String?
  frequency                     TaskFrequency
  startTrigger                  String?
  completionDeadline            String?
  completionOutput              String?
  primaryResponsibleDesignation String?
  primaryResponsibleEmployeeId  String?
  parentActivityId              String?
  evidenceRequired              String?
  effectiveFrom                 DateTime
  status                        ActivityStatus @default(ACTIVE)
  remarks                       String?
  scope                         ActivityScope?
  scopeDepartmentId             String?
  scopeJobTitle                 String?
  scopeJobTitleLabel            String?
  scopeEmployeeId               String?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  organization               Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mainDepartment             Department?                  @relation(fields: [mainDepartmentId], references: [id], onDelete: SetNull)
  scopeDepartment            Department?                  @relation("ActivityScopeDepartment", fields: [scopeDepartmentId], references: [id], onDelete: SetNull)
  scopeEmployee              Employee?                    @relation("ActivityScopeEmployee", fields: [scopeEmployeeId], references: [id], onDelete: SetNull)
  primaryResponsibleEmployee Employee?                    @relation("ActivityPrimaryResponsible", fields: [primaryResponsibleEmployeeId], references: [id], onDelete: SetNull)
  parentActivity             Activity?                    @relation("ActivityParent", fields: [parentActivityId], references: [id], onDelete: SetNull)
  childActivities            Activity[]                   @relation("ActivityParent")
  tasks                      Task[]
  jobTitleActivities         JobTitleActivity[]
  employeeAssignments        EmployeeActivityAssignment[]
  ingestionRows              ActivityIngestionRow[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([mainDepartmentId])
  @@index([primaryResponsibleEmployeeId])
  @@index([parentActivityId])
  @@index([organizationId, scope])
  @@index([scopeDepartmentId])
  @@index([scopeEmployeeId])
  @@index([organizationId, scopeJobTitle])
}

model JobTitleActivity {
  id             String   @id @default(uuid())
  organizationId String
  jobTitle       String
  activityId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, jobTitle, activityId])
  @@index([organizationId, jobTitle])
  @@index([activityId])
}

model EmployeeActivityAssignment {
  id             String                 @id @default(uuid())
  organizationId String
  employeeId     String
  activityId     String
  status         EmployeeActivityStatus @default(ACTIVE)
  activatedAt    DateTime?
  deactivatedAt  DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  activity     Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([employeeId, activityId])
  @@index([organizationId, status])
  @@index([employeeId, status])
  @@index([activityId])
}

model ActivityIngestion {
  id                 String    @id @default(uuid())
  organizationId     String
  fileName           String
  uploadedById       String
  requestedByUserId  String?
  requestedRoleLevel String?
  status             String    @default("QUEUED")
  totalRows          Int       @default(0)
  successfulRows     Int       @default(0)
  failedRows         Int       @default(0)
  attempts           Int       @default(0)
  availableAt        DateTime  @default(now())
  startedAt          DateTime?
  failedAt           DateTime?
  failureMessage     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   Employee               @relation("ActivityIngestionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  rows         ActivityIngestionRow[]

  @@index([organizationId, createdAt])
  @@index([uploadedById])
  @@index([status])
  @@index([status, availableAt])
  @@index([status, updatedAt])
}

model ActivityIngestionRow {
  id                      String   @id @default(uuid())
  ingestionId             String
  organizationId          String
  rowNumber               Int
  status                  String   @default("QUEUED")
  payload                 Json?
  targetActivityId        String?  @unique
  parentActivityCode      String?
  activityName            String?
  activityCode            String?
  responsibleEmployeeCode String?
  scope                   ActivityScope?
  scopeTarget             String?
  assignedCount           Int      @default(0)
  message                 String?
  activityId              String?
  taskId                  String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  ingestion    ActivityIngestion @relation(fields: [ingestionId], references: [id], onDelete: Cascade)
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activity     Activity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  task         Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([ingestionId, rowNumber])
  @@index([organizationId, status])
  @@index([activityId])
  @@index([taskId])
}

