// Area 03 owns this aggregate. Stable IDs and approved snapshots are stored once;
// other areas consume the approved handover instead of copying planning records.
model LexPlanningWorkspace {
  organizationId String @id
  revision       Int @default(0)
  state          Json
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence       LexPlanningEvidence[]
}

model LexPlanningEvidence {
  id             String @id @default(uuid())
  organizationId String
  findingId      String
  name           String
  mimeType       String
  size           Int
  content        Bytes
  uploadedBy     String
  createdAt      DateTime @default(now())
  workspace      LexPlanningWorkspace @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade, map: "LexPlanningEvidence_workspace_fkey")

  @@index([organizationId, findingId])
}

// Shared example content, not organisation planning records. Selecting a
// template copies editable fields into a draft; it never links tenant records
// or changes the library. Stable IDs prevent duplicates during provisioning.
model LexPlanningLibraryTemplate {
  id                   String   @id
  kind                 String
  title                String
  pillar               String
  category             String?
  department           String?
  sourceCode           String
  sourceSheet          String
  sourceRow            Int
  ownerRole            String?
  parentObjectiveCode  String?
  parentObjectiveTitle String?
  fields               Json
  notes                String[] @default([])
  active               Boolean  @default(true)
  version              Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([kind, sourceCode])
  @@index([kind, active, pillar])
}
