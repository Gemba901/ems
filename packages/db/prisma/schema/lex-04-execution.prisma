// Area 04 stores execution updates only. Approved plans, goals, assignments and
// schedules stay in Area 03 and are referenced by immutable IDs and versions.
model LexExecutionWorkspace {
  organizationId String       @id
  revision       Int          @default(0)
  state          Json
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
