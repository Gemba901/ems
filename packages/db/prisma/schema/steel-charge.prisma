// Tracks how far the charge preparation has progressed through P04-A01..A12
enum SteelChargeStage {
  A01_REQUIREMENT_REVIEWED
  A02_LOTS_SELECTED
  A03_SCRAP_SORTED
  A04_SCRAP_CUT
  A05_CONTAMINANTS_REMOVED
  A06_ADDITIVES_PREPARED
  A07_RETURN_SCRAP_CHECKED
  A08_RECIPE_PREPARED
  A09_MATERIAL_STAGED
  A10_VERIFICATION_DONE
  A11_CHARGE_RELEASED
  A12_HANDOVER_CLOSED
}

enum SteelChargeStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  CLOSED
  CANCELLED
}

// Identifies each of the 12 charge-preparation activities for the audit trail
enum SteelChargeActivity {
  A01
  A02
  A03
  A04
  A05
  A06
  A07
  A08
  A09
  A10
  A11
  A12
  STATUS_OVERRIDE
}

// One record per furnace charge prepared against a released production plan,
// carried through P04-A01 -> P04-A12. Hands off to P05 (furnace) once
// released and closed (no P05 model exists in this repository yet).
model SteelChargePreparation {
  id             String            @id @default(uuid())
  prepNumber     String            @unique
  organizationId String
  planId         String
  createdById    String
  stage          SteelChargeStage  @default(A01_REQUIREMENT_REVIEWED)
  status         SteelChargeStatus @default(DRAFT)

  // P04-A01 — Review production plan and material requirement
  stockAvailabilityConfirmed Boolean?
  requirementNotes           String?

  // P04-A02 — Select raw material lots for preparation (see SteelChargeMaterialLot)
  lotSelectionNotes String?

  // P04-A03 — Sort scrap by grade and usability
  sortedWeightTonnes Float?
  rejectedItemsNotes String?
  scrapGradeNotes    String?

  // P04-A04 — Cut oversized scrap if needed
  cuttingRequired       Boolean?
  cuttingTimeMinutes    Float?
  cuttingPowerOrGasUsed String?
  cutQuantityTonnes     Float?

  // P04-A05 — Remove contaminants and unsafe items
  contaminantsRemoved     Boolean?
  removedItemsNotes       String?
  contaminationIssueNotes String?

  // P04-A06 — Prepare additives and alloys
  additivesPrepared Json?
  additivesNotes    String?

  // P04-A07 — Check internal return scrap availability
  returnScrapQtyTonnes          Float?
  returnScrapSource             String?
  returnScrapGrade              String?
  returnScrapContaminationNotes String?
  returnScrapAvailable          Boolean?

  // P04-A08 — Prepare furnace charge recipe
  recipeScrapWeightTonnes    Float?
  recipeDriWeightTonnes      Float?
  recipeAlloyWeightTonnes    Float?
  recipeAdditiveWeightTonnes Float?
  targetChemistry            Json?
  recipeNotes                String?

  // P04-A09 — Stage material near furnace charging area
  stagingLocation    String?
  stagedWeightTonnes Float?
  stagingSequence    Int?

  // P04-A10 — Verify actual material against charge recipe
  actualWeightTonnes   Float?
  actualGrade          String?
  weightVarianceTonnes Float?
  varianceApproved     Boolean?
  verificationNotes    String?

  // P04-A11 — Create and release Charge ID
  chargeNumber     String?   @unique
  chargeReleasedAt DateTime?

  // P04-A12 — Close preparation handover to furnace
  furnaceReadinessConfirmed Boolean?
  plannedHeatReference      String?
  handoverNotes             String?
  handoverClosedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization                        @relation(fields: [organizationId], references: [id])
  plan         SteelProductionPlan                 @relation(fields: [planId], references: [id])
  createdBy    Employee                            @relation("SteelChargePrepCreatedBy", fields: [createdById], references: [id])
  materialLots SteelChargeMaterialLot[]
  activityLogs SteelChargePreparationActivityLog[]
  melting      SteelMelting?

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, status])
  @@index([planId])
}

// P04-A02: join table linking a charge preparation to the SteelMaterialIntake
// records (lots) selected for it. There is no separate "lot" model — a
// released SteelMaterialIntake already serves as the material lot.
model SteelChargeMaterialLot {
  id                  String   @id @default(uuid())
  chargePreparationId String
  intakeId            String
  createdAt           DateTime @default(now())

  chargePreparation SteelChargePreparation @relation(fields: [chargePreparationId], references: [id], onDelete: Cascade)
  intake            SteelMaterialIntake    @relation(fields: [intakeId], references: [id])

  @@unique([chargePreparationId, intakeId])
  @@unique([intakeId])
  @@index([chargePreparationId])
}

// Audit trail: every activity performed against a charge preparation is recorded here
model SteelChargePreparationActivityLog {
  id                  String              @id @default(uuid())
  chargePreparationId String
  activity            SteelChargeActivity
  performedById       String
  notes               String?
  data                Json?
  createdAt           DateTime            @default(now())

  chargePreparation SteelChargePreparation @relation(fields: [chargePreparationId], references: [id], onDelete: Cascade)
  performedBy       Employee               @relation("SteelChargePrepPerformedBy", fields: [performedById], references: [id])

  @@index([chargePreparationId])
}

// ── Steel Manufacturing: Process 5 — Melting (P05-A01..A14) ─────────────
// Hands off from P04 (Charge Preparation) once a charge has been closed and
// handed over to the furnace. Hands off conceptually to P06 (Heat Approval)
// once refining handover (P05-A14) closes this record — no P06 model/code
// exists yet in this repository.
