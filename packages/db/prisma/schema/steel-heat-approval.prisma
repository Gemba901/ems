enum SteelHeatApprovalStage {
  A01_TAKE_SAMPLE
  A02_ANALYZE_SAMPLE
  A03_COMPARE_CHEMISTRY
  A04_DECIDE_CORRECTION
  A05_ADD_CORRECTION_MATERIAL
  A06_RETEST_CHEMISTRY
  A07_CHECK_TEMPERATURE
  A08_CHECK_LADLE_READINESS
  A09_APPROVE_CHEMISTRY_TEMPERATURE
  A10_CONFIRM_HEAT_NUMBER
  A11_TAPPING_APPROVAL
  A12_TAP_TO_LADLE
  A13_RELEASE_TO_CASTING
}

enum SteelHeatApprovalStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  CLOSED
  CANCELLED
}

// Identifies each of the 13 heat-approval activities for the audit trail
enum SteelHeatApprovalActivity {
  A01
  A02
  A03
  A04
  A05
  A06
  A07
  A08
  A09
  A10
  A11
  A12
  A13
  STATUS_OVERRIDE
}

// One record per heat, created against a P05 melting record that has been
// handed over to refining (A14_HANDOVER_TO_REFINING / CLOSED). Carries the
// heat through chemistry sampling, correction, approval, tapping, and
// release to casting (P06-A01 -> P06-A13). Hands off to P07 (casting) once
// closed (no P07 model exists in this repository yet).
model SteelHeatApproval {
  id             String                  @id @default(uuid())
  approvalNumber String                  @unique
  organizationId String
  createdById    String
  meltingId      String                  @unique
  stage          SteelHeatApprovalStage  @default(A01_TAKE_SAMPLE)
  status         SteelHeatApprovalStatus @default(DRAFT)

  // P06-A01 — Take liquid steel sample
  sampleRef     String?
  sampleTakenAt DateTime?

  // P06-A02 — Analyze sample in spectrometer/lab
  chemistryComposition Json?
  labRef               String?

  // P06-A03 — Compare chemistry with required grade
  requiredGrade           String?
  chemistryMatchesGrade   Boolean?
  chemistryDeviationNotes String?

  // P06-A04 — Decide correction requirement
  correctionRequired Boolean?
  correctionReason   String?

  // P06-A05 — Add alloy, carbon raiser, lime, or correction material (conditional)
  correctionMaterials     Json?
  correctionNotApplicable Boolean?

  // P06-A06 — Re-test chemistry if required (conditional). Each time a
  // re-test still doesn't match the required grade, the record loops back
  // to A04_DECIDE_CORRECTION for another correction pass and this counter
  // increments — capped (see heat-approval.service.ts) since repeated
  // correction is itself a cost/delay signal worth surfacing.
  retestChemistryComposition Json?
  retestNotApplicable        Boolean?
  correctionAttempts         Int      @default(0)

  // P06-A07 — Check liquid steel temperature
  liquidTemperatureCelsius Float?

  // P06-A08 — Check ladle readiness and lining condition
  ladleId              String?
  ladleLiningCondition String?
  ladleReady           Boolean?

  // P06-A09 — Approve chemistry and temperature
  chemistryTemperatureApproved Boolean?
  approvalNotes                String?

  // P06-A10 — Create or confirm heat number
  heatNumber String? @unique

  // P06-A11 — Give tapping approval
  tappingApproved Boolean?

  // P06-A12 — Tap liquid steel into ladle
  tapStartTime DateTime?
  tapEndTime   DateTime?
  tapOperator  String?

  // P06-A13 — Release approved heat to casting (irreversible)
  releasedToCastingAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization                   @relation(fields: [organizationId], references: [id])
  createdBy    Employee                       @relation("SteelHeatApprovalCreatedBy", fields: [createdById], references: [id])
  melting      SteelMelting                   @relation(fields: [meltingId], references: [id])
  activityLogs SteelHeatApprovalActivityLog[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, status])
}

// Audit trail: every activity performed against a heat-approval record is recorded here
model SteelHeatApprovalActivityLog {
  id             String                    @id @default(uuid())
  heatApprovalId String
  activity       SteelHeatApprovalActivity
  performedById  String
  notes          String?
  data           Json?
  createdAt      DateTime                  @default(now())

  heatApproval SteelHeatApproval @relation(fields: [heatApprovalId], references: [id], onDelete: Cascade)
  performedBy  Employee          @relation("SteelHeatApprovalPerformedBy", fields: [performedById], references: [id])

  @@index([heatApprovalId])
}
