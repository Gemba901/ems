// One record per customer demand / production plan, carried through P01-A01 -> P01-A12.
enum SteelMaterialType {
  SCRAP
  DRI
  BILLET
  ALLOY
  ADDITIVE
  FUEL
  REFRACTORY
  PACKING_MATERIAL
  OTHER
}

enum SupplierApprovalStatus {
  APPROVED
  PENDING
  SUSPENDED
  BLACKLISTED
}

enum SupplierRiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Steel Configuration — procurement master-data (P02 data foundation)
enum SteelProcurementType {
  LOCAL
  IMPORT
  BOTH
}

enum SteelLookupType {
  PAYMENT_TERMS
  INCOTERM
  CURRENCY
  TRANSPORT_MODE
  DELIVERY_LOCATION
  DOCUMENT_TYPE
}

// Generic configurable lookup lists for procurement supporting data (P02-A08/A09/A10)
// that don't warrant a dedicated table each — admin-defined, never hard-coded.
model SteelLookup {
  id             String          @id @default(uuid())
  organizationId String
  type           SteelLookupType
  code           String
  name           String
  isActive       Boolean         @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Employee?    @relation("SteelLookupCreatedBy", fields: [createdById], references: [id])
  updatedBy    Employee?    @relation("SteelLookupUpdatedBy", fields: [updatedById], references: [id])

  @@unique([organizationId, type, code])
  @@index([organizationId, type])
}

// Supplier ↔ Material eligibility (P02-A03: "which approved suppliers can supply
// this material?"). Distinct from Supplier.materialTypes (coarse category match) —
// this is a specific, admin-curated per-material approval.
model SteelSupplierMaterial {
  id                     String   @id @default(uuid())
  organizationId         String
  supplierId             String
  materialId             String
  isEligible             Boolean  @default(true)
  specificationReference String?
  isActive               Boolean  @default(true)
  createdById            String?
  updatedById            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  material     SteelMaterialMaster @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdBy    Employee?           @relation("SteelSupplierMaterialCreatedBy", fields: [createdById], references: [id])
  updatedBy    Employee?           @relation("SteelSupplierMaterialUpdatedBy", fields: [updatedById], references: [id])

  @@unique([supplierId, materialId])
  @@index([organizationId])
  @@index([materialId])
}

// Configurable QCD (Quality/Cost/Delivery) weighting used by P02-A06 to compare
// supplier quotations. Weights are admin-defined, never hard-coded scoring logic.
model SteelQcdCriteria {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  qualityWeight  Float
  costWeight     Float
  deliveryWeight Float
  isActive       Boolean  @default(true)
  createdById    String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    Employee?    @relation("SteelQcdCriteriaCreatedBy", fields: [createdById], references: [id])
  updatedBy    Employee?    @relation("SteelQcdCriteriaUpdatedBy", fields: [updatedById], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum SteelSourcingStage {
  A01_REQUIREMENT_REVIEWED
  A02_MATERIAL_TYPE_IDENTIFIED
  A03_SUPPLIER_CHECKED
  A04_SUPPLIER_RISK_REVIEWED
  A05_QUOTATIONS_COLLECTED
  A06_SUPPLIER_SELECTED
  A07_SPEC_CONFIRMED
  A08_PO_CREATED
  A09_DELIVERY_CONFIRMED
  A10_LOGISTICS_PREPARED
  A11_INTAKE_INFORMED
  A12_HANDOVER_CLOSED
}

// P02-A03 — how a sourcing requirement's material will be fulfilled
enum SteelSourcingMaterialSource {
  EXISTING_STOCK
  EXTERNAL_SUPPLIER
}

enum SteelSourcingStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  PO_ISSUED
  CLOSED
  CANCELLED
}

// Identifies each of the 12 sourcing activities for the audit trail
enum SteelSourcingActivity {
  A01
  A02
  A03
  A04
  A05
  A06
  A07
  A08
  A09
  A10
  A11
  A12
  STATUS_OVERRIDE
}

// Tracks how far the intake has progressed through P03-A01..A14
enum SteelIntakeStage {
  A01_GATE_ARRIVAL_RECORDED
  A02_DOCUMENTS_VERIFIED
  A03_GROSS_WEIGHT_CAPTURED
  A04_SAFETY_CHECKED
  A05_AREA_ASSIGNED
  A06_VISUAL_INSPECTED
  A07_HAZARD_CHECKED
  A08_RADIATION_CHECKED
  A09_CERTIFICATE_VERIFIED
  A10_ACCEPTANCE_DECIDED
  A11_UNLOADED
  A12_NET_WEIGHT_CAPTURED
  A13_YARD_STORED
  A14_STOCK_RELEASED
}

enum SteelIntakeStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  REJECTED
  RELEASED
  CANCELLED
}

// P03-A10 — Decide accept, hold, or reject material
enum MaterialAcceptanceDecision {
  ACCEPT
  HOLD
  REJECT
}

// Identifies each of the 14 intake activities for the audit trail
enum SteelIntakeActivity {
  A01
  A02
  A03
  A04
  A05
  A06
  A07
  A08
  A09
  A10
  A11
  A12
  A13
  A14
  STATUS_OVERRIDE
}

// Approved supplier master — checked at P02-A03/A04, referenced by every sourcing order.
model Supplier {
  id             String                 @id @default(uuid())
  organizationId String
  name           String
  code           String?
  materialTypes  SteelMaterialType[]    @default([])
  approvalStatus SupplierApprovalStatus @default(PENDING)
  rejectionCount Int                    @default(0)
  qualityScore   Float?
  deliveryScore  Float?
  contactPerson  String?
  phone          String?
  email          String?
  country        String?
  isImportSource Boolean                @default(false)
  isActive       Boolean                @default(true)
  notes          String?
  createdById    String?
  updatedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization      Organization             @relation(fields: [organizationId], references: [id])
  sourcingOrders    SteelSourcingOrder[]
  quotations        SteelSourcingQuotation[]
  eligibleMaterials SteelSupplierMaterial[]
  createdBy         Employee?                @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  updatedBy         Employee?                @relation("SupplierUpdatedBy", fields: [updatedById], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, approvalStatus])
}

// One record per material requirement sourced against a released production plan,
// carried through P02-A01 -> P02-A12.
model SteelSourcingOrder {
  id             String              @id @default(uuid())
  sourcingNumber String              @unique
  organizationId String
  planId         String
  createdById    String
  stage          SteelSourcingStage  @default(A01_REQUIREMENT_REVIEWED)
  status         SteelSourcingStatus @default(DRAFT)

  // P02-A01 — Review material requirement from production plan
  materialRequirementNotes String?
  requiredByDate           DateTime?

  // P02-A02 — Identify material type needed
  materialType      SteelMaterialType?
  materialTypeNotes String?

  // P02-A03 — Select material source: fulfilled from existing stock, or
  // purchased from an external supplier. Supplier fields only apply to the
  // EXTERNAL_SUPPLIER path; stockFulfillmentNotes only to EXISTING_STOCK.
  // Real stock quantity/location lookup is not modeled yet — this only
  // records the fulfillment decision itself.
  materialSource            SteelSourcingMaterialSource?
  supplierId                String?
  supplierApprovalConfirmed Boolean?
  supplierCheckNotes        String?
  stockFulfillmentNotes     String?

  // P02-A04 — Check supplier quality and rejection history
  supplierRiskLevel     SupplierRiskLevel?
  rejectionRateNotes    String?
  complaintHistoryNotes String?

  // P02-A05 — Collect price and availability confirmation (see SteelSourcingQuotation)
  quotationsCollectedAt DateTime?

  // P02-A06 — Compare supplier options using QCD logic
  selectedSupplierId String?
  qcdComparisonNotes String?

  // P02-A07 — Confirm technical specification and documents required
  specificationRequirementNotes String?
  certificateRequired           Boolean?
  documentsRequired             String[] @default([])

  // P02-A08 — Create purchase order
  poNumber        String?
  poItem          String?
  poQuantity      Float?
  poPrice         Float?
  poCurrency      String?
  poDeliveryTerms String?
  poCreatedAt     DateTime?

  // P02-A09 — Confirm delivery schedule with supplier
  confirmedDispatchDate DateTime?
  confirmedArrivalDate  DateTime?
  vehicleContainerInfo  String?

  // P02-A10 — Prepare import/local logistics if applicable (Imported Billet Route)
  billOfLading         String?
  countryOfOrigin      String?
  portClearanceStatus  String?
  importLogisticsNotes String?

  // P02-A11 — Inform raw material intake team
  intakeInformedAt  DateTime?
  intakeNotifyNotes String?

  // P02-A12 — Close sourcing handover to intake
  handoverClosedAt DateTime?
  handoverNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization               @relation(fields: [organizationId], references: [id])
  plan            SteelProductionPlan        @relation(fields: [planId], references: [id])
  createdBy       Employee                   @relation("SteelSourcingCreatedBy", fields: [createdById], references: [id])
  supplier        Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quotations      SteelSourcingQuotation[]
  activityLogs    SteelSourcingActivityLog[]
  attachments     SteelSourcingAttachment[]
  materialIntakes SteelMaterialIntake[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, status])
  @@index([planId])
}

// P02-A05: one quotation per supplier considered, used for the P02-A06 QCD comparison.
model SteelSourcingQuotation {
  id                String    @id @default(uuid())
  sourcingId        String
  supplierId        String
  price             Float
  currency          String    @default("USD")
  quantityAvailable Float?
  deliveryDate      DateTime?
  paymentTerms      String?
  qualityRiskNotes  String?
  createdAt         DateTime  @default(now())

  order    SteelSourcingOrder @relation(fields: [sourcingId], references: [id], onDelete: Cascade)
  supplier Supplier           @relation(fields: [supplierId], references: [id])

  @@index([sourcingId])
}

// Audit trail: every activity performed against a sourcing order is recorded here
model SteelSourcingActivityLog {
  id            String                @id @default(uuid())
  sourcingId    String
  activity      SteelSourcingActivity
  performedById String
  notes         String?
  data          Json?
  createdAt     DateTime              @default(now())

  order       SteelSourcingOrder @relation(fields: [sourcingId], references: [id], onDelete: Cascade)
  performedBy Employee           @relation("SteelSourcingPerformedBy", fields: [performedById], references: [id])

  @@index([sourcingId])
}

// Supporting documents/certificates attached to a sourcing order at a given
// stage (e.g. supplier qualification docs, quotations, PO/technical certs,
// delivery/shipping docs). Files themselves live in S3 via the existing
// generic presigned-upload flow; this model only records the resulting URL.
model SteelSourcingAttachment {
  id             String             @id @default(uuid())
  organizationId String
  sourcingId     String
  stage          SteelSourcingStage
  fileName       String
  fileUrl        String
  uploadedById   String?
  createdAt      DateTime           @default(now())

  order      SteelSourcingOrder @relation(fields: [sourcingId], references: [id], onDelete: Cascade)
  uploadedBy Employee?          @relation("SteelSourcingAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([sourcingId])
  @@index([organizationId])
}

model SteelProductionPlan {
  id             String                 @id @default(uuid())
  planNumber     String                 @unique
  organizationId String
  createdById    String
  stage          SteelPlanStage         @default(A01_DEMAND_CAPTURED)
  status         SteelPlanOverallStatus @default(DRAFT)

  // P01-A01 — Capture customer enquiry, sales order, forecast, or stock requirement
  demandSource              DemandSource
  customerId                String?
  customerName              String?
  dealerName                String?
  projectReference          String?
  salesOrderNumber          String?
  forecastReference         String?
  stockRequirementReference String?
  expectedDeliveryDate      DateTime?
  requestedQuantityTonnes   Float
  demandNotes               String?

  // P01-A02 — Confirm customer and order priority
  priority            OrderPriority?
  deliveryPromiseDate DateTime?
  creditStatus        CreditStatus?

  // P01-A03 — Confirm product type and standard required
  productId             String?
  productType           ProductType?
  productStandard       String?
  customerSpecification String?

  // P01-A04 — Confirm grade, size, length, bundle, and quantity
  productSpecificationId String?
  grade                  String?
  size                   String?
  length                 String?
  bundleType             String?
  totalQuantity          Float?
  toleranceNotes         String?

  // P01-A05 — Check certified finished goods stock
  certifiedStockAvailableQty Float?
  stockBundleIds             String[] @default([])
  stockHeatNumbers           String[] @default([])
  stockCertificateRefs       String[] @default([])

  // P01-A06 — Decide dispatch from stock or production required
  stockDecision      StockDecision?
  stockDecisionNotes String?

  // P01-A07 — Select applicable plant route
  productionRouteId String?
  plantRoute        PlantRoute?
  routeNotes        String?

  // P01-A08 — Check raw material or billet availability
  materialAvailability     AvailabilityStatus?
  materialShortageNotes    String?
  purchaseRequirementNotes String?

  // P01-A09 — Check equipment, maintenance, and manpower availability
  equipmentAvailability    AvailabilityStatus?
  manpowerAvailability     AvailabilityStatus?
  maintenanceShutdownNotes String?
  shiftPlanNotes           String?

  // P01-A10 — Prepare production plan and sequence
  productionSequence Json?
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  planNotes          String?

  // P01-A11 — Communicate plan to all concerned departments
  planCommunicatedAt DateTime?

  // P01-A12 — Release approved production plan
  approvedById String?
  approvedAt   DateTime?
  releaseNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization         Organization               @relation(fields: [organizationId], references: [id])
  createdBy            Employee                   @relation("SteelPlanCreatedBy", fields: [createdById], references: [id])
  approvedBy           Employee?                  @relation("SteelPlanApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  activityLogs         SteelPlanActivityLog[]
  departmentAcks       SteelPlanDepartmentAck[]
  sourcingOrders       SteelSourcingOrder[]
  chargePreparations   SteelChargePreparation[]
  customer             Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  product              SteelProduct?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSpecification SteelProductSpecification? @relation(fields: [productSpecificationId], references: [id], onDelete: SetNull)
  productionRoute      SteelProductionRoute?      @relation(fields: [productionRouteId], references: [id], onDelete: SetNull)
  stockFulfilmentItems StockFulfilmentItem[]

  @@index([organizationId])
  @@index([organizationId, stage])
  @@index([organizationId, status])
  @@index([customerId])
}

// Audit trail: every activity performed against a plan is recorded here
model SteelPlanActivityLog {
  id            String            @id @default(uuid())
  planId        String
  activity      SteelPlanActivity
  performedById String
  notes         String?
  data          Json?
  createdAt     DateTime          @default(now())

  plan        SteelProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  performedBy Employee            @relation(fields: [performedById], references: [id])

  @@index([planId])
}

// P01-A11: department acknowledgement of the communicated plan
model SteelPlanDepartmentAck {
  id               String          @id @default(uuid())
  planId           String
  department       SteelDepartment
  acknowledged     Boolean         @default(false)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  notes            String?
  createdAt        DateTime        @default(now())

  plan           SteelProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  acknowledgedBy Employee?           @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@unique([planId, department])
  @@index([planId])
}
