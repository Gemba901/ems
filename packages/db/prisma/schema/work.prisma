// TEAM WORKSPACE: projects, tasks, simple sprints and daily attendance.
// Attendance is independent of task work: no model here links the two.
//
// Rules Prisma cannot express live in the migration SQL:
//   - one open AttendanceRecord per employee (partial unique index)
//   - one ACTIVE WorkSprint per project (partial unique index)
//   - location / time / text-length CHECK constraints

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum WorkSprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

// MANAGER can edit the project, its membership and its sprints.
enum WorkProjectRole {
  MANAGER
  MEMBER
}

enum AttendanceLocationStatus {
  CAPTURED
  MISSING
}

model WorkProject {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    Employee?           @relation("WorkProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members      WorkProjectMember[]
  tasks        WorkTask[]
  sprints      WorkSprint[]

  @@index([organizationId, name])
}

model WorkProjectMember {
  projectId  String
  employeeId String
  role       WorkProjectRole @default(MEMBER)
  joinedAt   DateTime        @default(now())

  project  WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([projectId, employeeId])
  @@index([employeeId])
}

model WorkTask {
  id          String         @id @default(uuid())
  projectId   String
  title       String
  description String?
  assigneeId  String?
  status      WorkTaskStatus @default(TODO)
  dueDate     DateTime?      @db.Date
  sprintId    String?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project   WorkProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee  Employee?         @relation("WorkTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sprint    WorkSprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  createdBy Employee?         @relation("WorkTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  comments  WorkTaskComment[]

  @@index([projectId, status])
  @@index([projectId, sprintId])
  @@index([assigneeId, status, dueDate])
}

model WorkTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  task   WorkTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Employee? @relation("WorkTaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model WorkSprint {
  id                 String           @id @default(uuid())
  projectId          String
  name               String
  goal               String?
  startDate          DateTime         @db.Date
  endDate            DateTime         @db.Date
  status             WorkSprintStatus @default(PLANNED)
  startedAt          DateTime?
  completedAt        DateTime?
  // Written once, in the completing transaction; never recalculated.
  completionSnapshot Json?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  project   WorkProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy Employee?   @relation("WorkSprintCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     WorkTask[]

  @@index([projectId, status])
}

// Open while clockOutAt is null; there is deliberately no separate status column.
model AttendanceRecord {
  id                String    @id @default(uuid())
  organizationId    String
  employeeId        String
  // Organization-local date of clockInAt, in timezoneAtClockIn.
  workDate          DateTime  @db.Date
  timezoneAtClockIn String
  clockInAt         DateTime
  clockOutAt        DateTime?

  locationStatus        AttendanceLocationStatus
  latitude              Float?
  longitude             Float?
  accuracyMeters        Float?
  // Device-reported capture time, separate from the server clockInAt.
  locationCapturedAt    DateTime?
  locationMissingReason String?

  // Client-generated keys so retried requests return the original result.
  clockInRequestId  String
  clockOutRequestId String?

  // Optimistic concurrency token for manager corrections.
  version         Int       @default(1)
  lastCorrectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Restrict: attendance history must survive employee removal attempts.
  employee     Employee               @relation("AttendanceEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  corrections  AttendanceCorrection[]

  @@unique([organizationId, employeeId, workDate])
  @@unique([organizationId, employeeId, clockInRequestId])
  @@index([organizationId, workDate])
  @@index([employeeId, workDate])
}

// Append-only: rows are inserted by corrections and never updated.
model AttendanceCorrection {
  id                  String    @id @default(uuid())
  organizationId      String
  attendanceRecordId  String
  actorId             String
  previousClockInAt   DateTime
  previousClockOutAt  DateTime?
  correctedClockInAt  DateTime
  correctedClockOutAt DateTime?
  reason              String
  createdAt           DateTime  @default(now())

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  actor            Employee         @relation("AttendanceCorrectionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([attendanceRecordId, createdAt])
}
