{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "target": "ES2023",
    "skipLibCheck": true,
    "strictNullChecks": true
  },
  "include": ["index.ts", "generated/**/*.ts"]
}
