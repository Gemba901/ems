{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "outDir": "./dist",
    "target": "ES2023",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": ["index.ts", "generated/**/*.ts", "prisma/seed.ts"]
}
